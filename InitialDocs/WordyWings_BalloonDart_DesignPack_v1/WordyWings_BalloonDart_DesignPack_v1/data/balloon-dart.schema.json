{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wordy-wings.balloon-dart.level.schema.json",
  "title": "Wordy Wings Balloon Dart Level",
  "type": "object",
  "required": [
    "id",
    "mechanic",
    "difficulty",
    "learningMode",
    "inputMode",
    "rounds",
    "reward"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "mechanic": {
      "const": "balloon_dart"
    },
    "title": {
      "type": "string"
    },
    "difficulty": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "learningMode": {
      "enum": [
        "pictureListening",
        "wordRecognition",
        "colorRecognition",
        "compoundListening",
        "sizeAndShape"
      ]
    },
    "inputMode": {
      "enum": [
        "drag",
        "tap",
        "both"
      ]
    },
    "rounds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/round"
      }
    },
    "reward": {
      "type": "object",
      "required": [
        "stars"
      ],
      "properties": {
        "stars": {
          "const": 3
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "targetRule": {
      "type": "object",
      "properties": {
        "semanticId": {
          "type": "string"
        },
        "requiredWord": {
          "type": "string"
        },
        "requiredShape": {
          "type": "string"
        },
        "requiredColor": {
          "type": "string"
        },
        "requiredSize": {
          "enum": [
            "small",
            "medium",
            "big"
          ]
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "movement": {
      "type": "object",
      "required": [
        "pattern"
      ],
      "properties": {
        "pattern": {
          "enum": [
            "gentleBob",
            "driftHorizontal",
            "driftVertical",
            "figureEight",
            "crossLane"
          ]
        },
        "amplitudeX": {
          "type": "number",
          "minimum": 0
        },
        "amplitudeY": {
          "type": "number",
          "minimum": 0
        },
        "periodMs": {
          "type": "number",
          "minimum": 1000
        },
        "speed": {
          "type": "number",
          "minimum": 0
        },
        "phase": {
          "type": "number"
        },
        "lane": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "word": {
          "type": "string"
        },
        "imageKey": {
          "type": "string"
        },
        "shape": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "size": {
          "enum": [
            "small",
            "medium",
            "big"
          ]
        },
        "audioKey": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "balloon": {
      "type": "object",
      "required": [
        "instanceId",
        "semantic",
        "movement"
      ],
      "properties": {
        "instanceId": {
          "type": "string"
        },
        "semantic": {
          "$ref": "#/$defs/semantic"
        },
        "movement": {
          "$ref": "#/$defs/movement"
        },
        "initialPosition": {
          "type": "object",
          "required": [
            "x",
            "y"
          ],
          "properties": {
            "x": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "y": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "balloonSkin": {
          "type": "string"
        },
        "labelMode": {
          "enum": [
            "visible",
            "fade",
            "hidden"
          ]
        }
      },
      "additionalProperties": false
    },
    "round": {
      "type": "object",
      "required": [
        "id",
        "instructionText",
        "instructionAudioKey",
        "target",
        "balloons",
        "aimAssist"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "instructionText": {
          "type": "string"
        },
        "instructionAudioKey": {
          "type": "string"
        },
        "target": {
          "$ref": "#/$defs/targetRule"
        },
        "balloons": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "$ref": "#/$defs/balloon"
          }
        },
        "aimAssist": {
          "enum": [
            "long",
            "medium",
            "short"
          ]
        },
        "seed": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}