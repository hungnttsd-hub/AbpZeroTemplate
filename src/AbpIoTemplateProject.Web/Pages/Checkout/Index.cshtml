@page "/checkout"
@using System.Globalization
@model AbpIoTemplateProject.Web.Pages.Checkout.IndexModel
@{
    Layout = "/Pages/Shared/Store/_StoreLayout.cshtml";
    ViewData["Title"] = "Thanh toán";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}
<section class="store-page-hero is-compact"><div class="container"><h1>Thanh toán an toàn</h1><p>Kiểm tra thông tin trước khi xác nhận đơn hàng.</p></div></section>
<section class="store-checkout-section">
    <div class="container store-cart-layout">
        <form method="post" class="store-checkout-form">
            <div asp-validation-summary="All" class="store-form-error"></div>
            <input asp-for="Input.IdempotencyKey" type="hidden" />
            <input asp-for="Input.CartKey" type="hidden" />
            <div class="store-form-card">
                <h2><span>1</span> Thông tin nhận hàng</h2>
                <div class="store-form-grid">
                    <label>Họ và tên<input asp-for="Input.FullName" autocomplete="name" /><span asp-validation-for="Input.FullName"></span></label>
                    <label>Số điện thoại<input asp-for="Input.Phone" autocomplete="tel" /><span asp-validation-for="Input.Phone"></span></label>
                    <label class="is-full">Email<input asp-for="Input.Email" autocomplete="email" /><span asp-validation-for="Input.Email"></span></label>
                    <label>Tỉnh / Thành phố<input asp-for="Input.Province" autocomplete="address-level1" /></label>
                    <label>Quận / Huyện<input asp-for="Input.District" autocomplete="address-level2" /></label>
                    <label>Phường / Xã<input asp-for="Input.Ward" autocomplete="address-level3" /></label>
                    <label class="is-full">Địa chỉ cụ thể<input asp-for="Input.AddressLine" autocomplete="street-address" /></label>
                    <label class="is-full">Ghi chú<textarea asp-for="Input.DeliveryNote" rows="3"></textarea></label>
                </div>
            </div>
            <div class="store-form-card">
                <h2><span>2</span> Phương thức giao hàng</h2>
                <div class="store-option-list">
                    @foreach (var method in Model.ShippingMethods)
                    {
                        <label><input asp-for="Input.ShippingMethodId" type="radio" value="@method.Id" /><span><strong>@method.Name</strong><small>@method.Description · @method.EstimatedDays ngày</small></span><b>@string.Format(culture, "{0:N0} ₫", method.Fee)</b></label>
                    }
                </div>
            </div>
            <div class="store-form-card">
                <h2><span>3</span> Phương thức thanh toán</h2>
                <div class="store-option-list">
                    <label><input asp-for="Input.PaymentMethod" type="radio" value="@PaymentMethod.CashOnDelivery" /><span><strong>Thanh toán khi nhận hàng</strong><small>Thanh toán tiền mặt cho đơn vị vận chuyển</small></span><i class="fa-solid fa-money-bill-wave"></i></label>
                    <label><input asp-for="Input.PaymentMethod" type="radio" value="@PaymentMethod.BankTransfer" /><span><strong>Chuyển khoản ngân hàng</strong><small>Thông tin chuyển khoản hiển thị sau khi đặt hàng</small></span><i class="fa-solid fa-building-columns"></i></label>
                    <label><input asp-for="Input.PaymentMethod" type="radio" value="@PaymentMethod.Online" /><span><strong>Thanh toán trực tuyến</strong><small>Cổng thanh toán được cấu hình theo môi trường</small></span><i class="fa-solid fa-credit-card"></i></label>
                </div>
            </div>
            <button class="store-button-primary store-place-order" type="submit">Xác nhận đặt hàng <i class="fa-solid fa-lock"></i></button>
        </form>
        <aside class="store-order-summary">
            <h2>Đơn hàng (@Model.Cart.TotalQuantity sản phẩm)</h2>
            <div class="store-checkout-products">
                @foreach (var item in Model.Cart.Items)
                {
                    <div><img src="@(item.ImageUrl ?? "/images/store/product-placeholder.svg")" alt="" /><span><strong>@item.ProductName</strong><small>@item.OptionSummary · SL @item.Quantity</small></span><b>@string.Format(culture, "{0:N0} ₫", item.LineTotal)</b></div>
                }
            </div>
            <dl>
                <div><dt>Tạm tính</dt><dd>@string.Format(culture, "{0:N0} ₫", Model.Cart.Subtotal)</dd></div>
                @if (Model.Cart.DiscountAmount > 0) { <div class="is-discount"><dt>Giảm giá</dt><dd>-@string.Format(culture, "{0:N0} ₫", Model.Cart.DiscountAmount)</dd></div> }
                <div class="store-summary-total"><dt>Tạm tính sau ưu đãi</dt><dd>@string.Format(culture, "{0:N0} ₫", Model.Cart.Subtotal - Model.Cart.DiscountAmount)</dd></div>
            </dl>
        </aside>
    </div>
</section>
