<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] | IZONE Admin</title>
    <link rel="stylesheet" href="~/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/libs/@@fortawesome/fontawesome-free/css/all.min.css" />
    <link rel="stylesheet" href="~/css/education-admin.css" asp-append-version="true" />
</head>
<body class="edu-admin-body">
    <div class="edu-admin-shell">
        <aside class="edu-admin-sidebar">
            <a class="edu-admin-brand" href="/Admin"><img src="~/izone-assets/images/logo.png" alt="IZONE" /><span>ADMIN</span></a>
            <nav aria-label="Điều hướng quản trị">
                <a href="/Admin"><i class="fas fa-chart-pie"></i> Tổng quan</a>
                <p class="edu-admin-nav-title">Đào tạo</p>
                <a href="/Admin/Courses"><i class="fas fa-book-open"></i> Khóa học</a>
                <a href="/Admin/Teachers"><i class="fas fa-chalkboard-teacher"></i> Giảng viên</a>
                <a href="/Admin/Classes"><i class="fas fa-calendar-alt"></i> Lớp khai giảng</a>
                <a href="/Admin/Students"><i class="fas fa-user-graduate"></i> Học viên</a>
                <a href="/Admin/Enrollments"><i class="fas fa-file-signature"></i> Ghi danh & học phí</a>
                <p class="edu-admin-nav-title">Tuyển sinh & nội dung</p>
                <a href="/Admin/Leads"><i class="fas fa-headset"></i> Lead tư vấn</a>
                <a href="/Admin/PlacementTests"><i class="fas fa-clipboard-check"></i> Kiểm tra trình độ</a>
                <a href="/Admin/Content/Articles"><i class="fas fa-newspaper"></i> Kho kiến thức</a>
                <a href="/Admin/Content/Documents"><i class="fas fa-folder-open"></i> Tài liệu</a>
            </nav>
            <div class="edu-admin-footer"><a href="/" target="_blank"><i class="fas fa-arrow-up-right-from-square"></i> Xem website</a><a href="/Account/Logout"><i class="fas fa-right-from-bracket"></i> Đăng xuất</a></div>
        </aside>
        <div class="edu-admin-main"><header class="edu-admin-header"><div><p>Hệ thống quản trị</p><h1>@ViewData["Title"]</h1></div><div class="edu-admin-user"><i class="fas fa-user-circle"></i> @(User.Identity?.Name ?? "Administrator")</div></header><main class="edu-admin-content">@RenderBody()</main></div>
    </div>
    <script src="~/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
