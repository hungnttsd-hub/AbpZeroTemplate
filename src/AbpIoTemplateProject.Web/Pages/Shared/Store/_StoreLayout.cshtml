@using System.Globalization
@using AbpIoTemplateProject.Localization
@using AbpIoTemplateProject.Web.Options
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@inject IStringLocalizer<AbpIoTemplateProjectResource> L
@inject IOptions<StorefrontOptions> StorefrontOptionsAccessor
@{
    var storefront = StorefrontOptionsAccessor.Value;
    var pageTitle = ViewData["Title"] as string;
    var documentTitle = string.IsNullOrWhiteSpace(pageTitle)
        ? storefront.BrandName
        : $"{pageTitle} | {storefront.BrandName}";
    var metaDescription = ViewData["MetaDescription"] as string ?? L["Store:MetaDescription"];
    var canonicalUrl = ViewData["CanonicalUrl"] as string;
    if (!string.IsNullOrWhiteSpace(canonicalUrl) && canonicalUrl.StartsWith('/'))
    {
        canonicalUrl = $"{Context.Request.Scheme}://{Context.Request.Host}{canonicalUrl}";
    }
    var culture = CultureInfo.CurrentUICulture;
}
<!DOCTYPE html>
<html lang="@culture.Name" dir="@(culture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="@metaDescription" />
    <meta name="theme-color" content="#087f6d" />
    <meta property="og:title" content="@documentTitle" />
    <meta property="og:description" content="@metaDescription" />
    <meta property="og:type" content="website" />
    @if (!string.IsNullOrWhiteSpace(canonicalUrl))
    {
        <link rel="canonical" href="@canonicalUrl" />
    }
    <title>@documentTitle</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/libs/@@fortawesome/fontawesome-free/css/all.css" />
    <link rel="stylesheet" href="~/css/store/store.css" asp-append-version="true" />

    @await RenderSectionAsync("styles", required: false)
</head>
<body class="store-body">
    <a class="store-skip-link" href="#store-main">@L["Store:SkipToContent"]</a>

    <partial name="/Pages/Shared/Store/_StoreHeader.cshtml" />
    <partial name="/Pages/Shared/Store/_StoreNavigation.cshtml" />

    <main id="store-main" tabindex="-1">
        @RenderBody()
    </main>

    <partial name="/Pages/Shared/Store/_StoreFooter.cshtml" />

    <button class="store-back-to-top"
            type="button"
            data-store-back-to-top
            aria-label="@L["Store:BackToTop"]">
        <i class="fa-solid fa-arrow-up" aria-hidden="true"></i>
    </button>

    <script src="~/libs/jquery/jquery.js"></script>
    <script src="~/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/libs/abp/core/abp.js"></script>
    <script src="~/libs/abp/jquery/abp.jquery.js"></script>
    <script src="~/js/store/store.js" asp-append-version="true"></script>

    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
