@using System.Globalization
@model ProductListItemDto
@{
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var displayPrice = Model.SalePrice ?? Model.ListPrice ?? 0;
}
<article class="store-product-card">
    <a class="store-product-image" href="/products/@Model.Slug">
        <img src="@(Model.ThumbnailUrl ?? "/images/store/product-placeholder.svg")" alt="@Model.Name" loading="lazy" />
        @if (Model.DiscountPercent > 0)
        {
            <span class="store-product-badge is-sale">-@Model.DiscountPercent%</span>
        }
        else if (Model.IsNew)
        {
            <span class="store-product-badge">Mới</span>
        }
    </a>
    <div class="store-product-card-body">
        <small>@Model.CategoryName</small>
        <h3><a href="/products/@Model.Slug">@Model.Name</a></h3>
        <div class="store-price">
            <strong>@string.Format(culture, "{0:N0} ₫", displayPrice)</strong>
            @if (Model.ListPrice.HasValue && Model.SalePrice.HasValue && Model.ListPrice > Model.SalePrice)
            {
                <del>@string.Format(culture, "{0:N0} ₫", Model.ListPrice)</del>
            }
        </div>
        <div class="store-product-actions">
            <span class="@(Model.IsInStock ? "is-in-stock" : "is-out-of-stock")">
                <i class="fa-solid fa-circle"></i> @(Model.IsInStock ? "Còn hàng" : "Hết hàng")
            </span>
            @if (Model.IsInStock && !Model.HasVariants)
            {
                <form method="post" action="/cart?handler=add">
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="quantity" value="1" />
                    <button type="submit" class="store-icon-button" aria-label="Thêm @Model.Name vào giỏ hàng">
                        <i class="fa-solid fa-cart-plus"></i>
                    </button>
                </form>
            }
            else
            {
                <a class="store-icon-button" href="/products/@Model.Slug" aria-label="Xem @Model.Name">
                    <i class="fa-solid fa-arrow-right"></i>
                </a>
            }
        </div>
    </div>
</article>
