@using System.Globalization
@using AbpIoTemplateProject.Localization
@using AbpIoTemplateProject.Web.Options
@using Microsoft.Extensions.Localization
@using Microsoft.Extensions.Options
@using Volo.Abp.Users
@inject IStringLocalizer<AbpIoTemplateProjectResource> L
@inject IOptions<StorefrontOptions> StorefrontOptionsAccessor
@inject ICurrentUser CurrentUser
@{
    var storefront = StorefrontOptionsAccessor.Value;
    var cartCount = ViewData["StoreCartCount"] is int count ? count : 0;
    var cartTotal = ViewData["StoreCartTotal"] is decimal total ? total : 0m;
    var formattedCartTotal = string.Format(CultureInfo.GetCultureInfo("vi-VN"), "{0:N0} ₫", cartTotal);
}

<header class="store-header">
    <div class="store-utility-bar">
        <div class="container store-utility-inner">
            <ul class="store-utility-benefits" aria-label="@L["Store:ServiceHighlights"]">
                <li>
                    <i class="fa-solid fa-truck-fast" aria-hidden="true"></i>
                    <span>@L["Store:ShippingNationwide"]</span>
                </li>
                <li>
                    <i class="fa-solid fa-hand-holding-dollar" aria-hidden="true"></i>
                    <span>@L["Store:CashOnDelivery"]</span>
                </li>
                <li class="d-none d-lg-flex">
                    <i class="fa-solid fa-shield-heart" aria-hidden="true"></i>
                    <span>@L["Store:GenuineProducts"]</span>
                </li>
            </ul>

            <nav class="store-utility-links" aria-label="@L["Store:UtilityNavigation"]">
                <a href="/track-order">
                    <i class="fa-solid fa-box" aria-hidden="true"></i>
                    <span>@L["Store:TrackOrder"]</span>
                </a>
                @if (CurrentUser.IsAuthenticated)
                {
                    <a href="/Account/Manage">
                        <i class="fa-regular fa-user" aria-hidden="true"></i>
                        <span>@(CurrentUser.Name ?? CurrentUser.UserName)</span>
                    </a>
                }
                else
                {
                    <a href="/Account/Login">@L["Store:Login"]</a>
                    <span class="store-utility-separator" aria-hidden="true">/</span>
                    <a href="/Account/Register">@L["Store:Register"]</a>
                }
            </nav>
        </div>
    </div>

    <div class="store-main-header">
        <div class="container store-main-header-inner">
            <button class="store-mobile-menu-button"
                    type="button"
                    data-bs-toggle="offcanvas"
                    data-bs-target="#storeMobileNavigation"
                    aria-controls="storeMobileNavigation"
                    aria-label="@L["Store:OpenMenu"]">
                <i class="fa-solid fa-bars" aria-hidden="true"></i>
            </button>

            <a class="store-brand" href="/" aria-label="@L["Store:GoToHomepage", storefront.BrandName]">
                <span class="store-brand-mark" aria-hidden="true">
                    <i class="fa-solid fa-leaf"></i>
                    <i class="fa-solid fa-water"></i>
                </span>
                <span class="store-brand-copy">
                    <strong>@storefront.BrandName</strong>
                    <small>@L["Store:BrandTagline"]</small>
                </span>
            </a>

            <form class="store-search"
                  action="/products"
                  method="get"
                  role="search"
                  data-store-search>
                <label class="visually-hidden" for="store-search-input">@L["Store:SearchLabel"]</label>
                <i class="fa-solid fa-magnifying-glass store-search-icon" aria-hidden="true"></i>
                <input id="store-search-input"
                       type="search"
                       name="q"
                       autocomplete="off"
                       placeholder="@L["Store:SearchPlaceholder"]"
                       aria-controls="store-search-suggestions"
                       aria-expanded="false" />
                <button type="submit">@L["Store:SearchButton"]</button>
                <div id="store-search-suggestions"
                     class="store-search-suggestions"
                     role="listbox"
                     hidden>
                    <p>@L["Store:SearchSuggestionHint"]</p>
                </div>
            </form>

            <div class="store-header-actions">
                <a class="store-support-link d-none d-xl-flex" href="tel:@storefront.Hotline">
                    <span class="store-action-icon">
                        <i class="fa-solid fa-headset" aria-hidden="true"></i>
                    </span>
                    <span>
                        <small>@L["Store:ConsultationHotline"]</small>
                        <strong>@storefront.Hotline</strong>
                    </span>
                </a>

                <a class="store-icon-link d-none d-md-flex" href="/stores" aria-label="@L["Store:StoreSystem"]">
                    <i class="fa-solid fa-location-dot" aria-hidden="true"></i>
                    <span>@L["Store:Stores"]</span>
                </a>

                <a class="store-icon-link d-none d-sm-flex" href="/Account/Manage" aria-label="@L["Store:MyAccount"]">
                    <i class="fa-regular fa-user" aria-hidden="true"></i>
                    <span>@L["Store:Account"]</span>
                </a>

                <a class="store-cart-link" href="/cart" aria-label="@L["Store:CartSummary", cartCount, formattedCartTotal]">
                    <span class="store-cart-icon">
                        <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
                        <span class="store-cart-count">@cartCount</span>
                    </span>
                    <span class="store-cart-copy">
                        <small>@L["Store:Cart"]</small>
                        <strong>@formattedCartTotal</strong>
                    </span>
                </a>
            </div>
        </div>

        <div class="container store-mobile-search">
            <form action="/products"
                  method="get"
                  role="search"
                  data-store-search>
                <label class="visually-hidden" for="store-mobile-search-input">@L["Store:SearchLabel"]</label>
                <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
                <input id="store-mobile-search-input"
                       type="search"
                       name="q"
                       autocomplete="off"
                       placeholder="@L["Store:SearchMobilePlaceholder"]"
                       aria-controls="store-mobile-search-suggestions"
                       aria-expanded="false" />
                <button type="submit" aria-label="@L["Store:SearchButton"]">
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </button>
                <div id="store-mobile-search-suggestions"
                     class="store-search-suggestions"
                     role="listbox"
                     hidden>
                    <p>@L["Store:SearchSuggestionHint"]</p>
                </div>
            </form>
        </div>
    </div>
</header>
