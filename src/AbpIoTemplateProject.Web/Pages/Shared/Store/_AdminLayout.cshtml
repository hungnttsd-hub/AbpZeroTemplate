@using Volo.Abp.Users
@inject ICurrentUser CurrentUser
@{
    var title = ViewData["Title"] as string ?? "Quản trị cửa hàng";
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title | Aqua Garden Admin</title>
    <link rel="stylesheet" href="~/libs/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/libs/@@fortawesome/fontawesome-free/css/all.css" />
    <link rel="stylesheet" href="~/css/store/admin.css" asp-append-version="true" />
    @await RenderSectionAsync("styles", false)
</head>
<body class="store-admin-body">
    <aside class="store-admin-sidebar">
        <a class="store-admin-brand" href="/admin/store"><i class="fa-solid fa-leaf"></i><span>Aqua Garden<small>Commerce Admin</small></span></a>
        <nav>
            <a href="/admin/store"><i class="fa-solid fa-chart-pie"></i> Tổng quan</a>
            <a href="/admin/store/products"><i class="fa-solid fa-box-open"></i> Sản phẩm</a>
            <a href="/admin/store/catalog"><i class="fa-solid fa-layer-group"></i> Danh mục & đối tác</a>
            <a href="/admin/store/inventory"><i class="fa-solid fa-warehouse"></i> Tồn kho</a>
            <a href="/admin/store/orders"><i class="fa-solid fa-receipt"></i> Đơn hàng</a>
            <a href="/admin/store/customers"><i class="fa-solid fa-users"></i> Khách hàng</a>
            <a href="/admin/store/payments"><i class="fa-solid fa-credit-card"></i> Thanh toán</a>
            <a href="/admin/store/content"><i class="fa-solid fa-bullhorn"></i> Nội dung & ưu đãi</a>
        </nav>
        <a class="store-admin-view-site" href="/"><i class="fa-solid fa-arrow-up-right-from-square"></i> Xem cửa hàng</a>
    </aside>
    <div class="store-admin-shell">
        <header class="store-admin-header">
            <button type="button" data-admin-menu aria-label="Mở menu"><i class="fa-solid fa-bars"></i></button>
            <div><small>Xin chào</small><strong>@(CurrentUser.Name ?? CurrentUser.UserName)</strong></div>
        </header>
        <main class="store-admin-main">@RenderBody()</main>
    </div>
    <script src="~/libs/jquery/jquery.js"></script>
    <script src="~/libs/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script>
        document.querySelector("[data-admin-menu]")?.addEventListener("click", function () {
            document.body.classList.toggle("is-admin-menu-open");
        });
    </script>
    @await RenderSectionAsync("scripts", false)
</body>
</html>
