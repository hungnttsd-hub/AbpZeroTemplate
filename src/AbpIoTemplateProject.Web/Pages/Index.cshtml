@page
@model AbpIoTemplateProject.Web.Pages.IndexModel
@{
    Layout = "/Pages/Shared/_IzoneLayout.cshtml";
    ViewData["Title"] = "Trung tâm luyện thi IELTS";
}

<section class="iz-hero" id="gioi-thieu">
    <div class="iz-container iz-hero-grid">
        <div class="iz-hero-copy">
            <p class="iz-eyebrow">IELTS CHIẾN LƯỢC</p>
            <h1>Học IELTS có lộ trình, tiến bộ theo từng bước</h1>
            <p class="iz-lead">IZONE đồng hành cùng người học từ mất gốc đến mục tiêu IELTS 7.0+, với giáo trình được thiết kế phù hợp cho học viên Việt Nam.</p>
            <div class="iz-actions"><a class="iz-btn iz-btn-primary" href="/Courses">Xem các khóa học</a><a class="iz-btn iz-btn-light" href="#dang-ky">Đăng ký tư vấn</a></div>
            <div class="iz-trust"><span><b>30.000+</b> học viên</span><span><b>8</b> khóa học</span><span><b>10+</b> năm đồng hành</span></div>
        </div>
        <div class="iz-hero-media"><img src="~/izone-assets/images/slider/1.jpg" alt="Học IELTS tại IZONE" /><div class="iz-hero-note"><strong>Lộ trình rõ ràng</strong><span>Từ cơ bản đến nâng cao</span></div></div>
    </div>
</section>

<section class="iz-benefits" aria-label="Điểm mạnh IZONE"><div class="iz-container iz-benefit-grid"><article><span class="iz-benefit-icon">01</span><div><h2>Đội ngũ giảng viên</h2><p>Tận tâm, vững chuyên môn và sát sao trong từng buổi học.</p></div></article><article><span class="iz-benefit-icon">02</span><div><h2>Thiết kế khóa học</h2><p>Giáo trình riêng, tối ưu cho cách học của người Việt.</p></div></article><article><span class="iz-benefit-icon">03</span><div><h2>Học phí tối ưu</h2><p>Đầu tư đúng trọng tâm để đạt mục tiêu IELTS bền vững.</p></div></article></div></section>

<section class="iz-section iz-course-section" id="khoa-hoc"><div class="iz-container"><div class="iz-heading"><p class="iz-eyebrow">LỘ TRÌNH HỌC IELTS</p><h2>Các khóa học tại IZONE</h2><p>Chọn đúng điểm xuất phát, học đúng thứ bạn cần.</p></div><div class="iz-course-grid">
@foreach (var course in Model.Courses)
{
    <a class="iz-course-card" href="/Courses"><img src="@(course.CoverImageUrl ?? Url.Content("~/izone-assets/images/khoahoc/1.jpg"))" alt="@course.Name" /><div><span>@course.EntryLevel — @course.TargetLevel</span><h3>@course.Name</h3><p>@course.ShortDescription</p><b>Tìm hiểu khóa học <i>→</i></b></div></a>
}
</div><a class="iz-btn iz-btn-outline" href="/Courses">Xem tất cả khóa học</a></div></section>

<section class="iz-method"><div class="iz-container iz-method-grid"><div class="iz-method-copy"><p class="iz-eyebrow">PHƯƠNG PHÁP ĐỘC QUYỀN</p><h2>Học bằng nhiều giác quan để nhớ sâu hơn</h2><p>Revised Multisensory Learning là phương pháp đa kênh giúp học viên tiếp nhận, luyện tập và ôn lại kiến thức đúng nhịp.</p><ol><li><b>01</b> Học tập đa giác quan, tăng khả năng ghi nhớ</li><li><b>02</b> Ôn tập hợp lý, hạn chế học trước quên sau</li><li><b>03</b> Áp dụng hiệu quả trên lộ trình cá nhân</li></ol></div><div class="iz-method-media"><img src="~/izone-assets/images/bg4.png" alt="Phương pháp học IZONE" /></div></div></section>

<section class="iz-section iz-teachers" id="giang-vien"><div class="iz-container"><div class="iz-heading"><p class="iz-eyebrow">ĐỘI NGŨ IZONE</p><h2>Gặp gỡ các giảng viên</h2><p>Những người trực tiếp đồng hành trên hành trình chinh phục IELTS của bạn.</p></div><div class="iz-teacher-grid">
@foreach (var teacher in Model.Teachers)
{
    <article><img src="@(teacher.AvatarUrl ?? Url.Content("~/izone-assets/images/giangvien/gv-1.jpg"))" alt="@teacher.FullName" /><div><span>@teacher.Credentials</span><h3>@teacher.FullName</h3></div></article>
}
</div></div></section>

<section class="iz-resources" id="tai-lieu"><div class="iz-container iz-resource-grid"><div><p class="iz-eyebrow">LUYỆN THI IELTS ONLINE</p><h2>Tài liệu và bài học theo từng kỹ năng</h2><p>Tự học Listening, Reading, Speaking, Writing và Grammar — Vocabulary qua các bài học có định hướng.</p><a class="iz-btn iz-btn-primary" href="#dang-ky">Nhận tư vấn lộ trình</a></div><div class="iz-resource-list"><a href="#dang-ky"><span>Listening</span><b>Luyện nghe từ nền tảng đến thực chiến</b><i>→</i></a><a href="#dang-ky"><span>Speaking</span><b>Xây phản xạ và phát triển câu trả lời</b><i>→</i></a><a href="#dang-ky"><span>Writing</span><b>Hiểu cách triển khai bài viết hiệu quả</b><i>→</i></a><a href="#dang-ky"><span>Reading</span><b>Luyện kỹ năng Skimming &amp; Scanning</b><i>→</i></a></div></div></section>

<section class="iz-register" id="dang-ky"><div class="iz-container iz-register-grid"><div><p class="iz-eyebrow">BẮT ĐẦU HÔM NAY</p><h2>Đăng ký nhận tư vấn khóa học</h2><p>Để lại thông tin, IZONE sẽ liên hệ hỗ trợ bạn chọn lộ trình phù hợp trong 24 giờ.</p><div class="iz-contact"><span>Hotline</span><a href="tel:0969091503">0969 091 503</a></div></div><form method="post" asp-page-handler="Lead"><label>Họ và tên<input required asp-for="Input.FullName" placeholder="Nhập họ và tên" /></label><label>Số điện thoại<input required asp-for="Input.PhoneNumber" type="tel" placeholder="Nhập số điện thoại" /></label><label>Email<input asp-for="Input.Email" type="email" placeholder="Nhập email (không bắt buộc)" /></label><label>Mục tiêu IELTS<input asp-for="Input.Target" placeholder="Ví dụ: 6.5 IELTS" /></label><button class="iz-btn iz-btn-primary" type="submit">Đăng ký tư vấn</button>@if (TempData["LeadSubmitted"] is not null) { <p class="iz-form-message">Cảm ơn bạn. IZONE sẽ liên hệ sớm!</p> }<span asp-validation-for="Input.FullName"></span><span asp-validation-for="Input.PhoneNumber"></span></form></div></section>
