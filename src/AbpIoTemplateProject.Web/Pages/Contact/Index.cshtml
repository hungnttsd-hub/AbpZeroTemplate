@page
@model AbpIoTemplateProject.Web.Pages.Contact.IndexModel
@{ Layout = "/Pages/Shared/_IzoneLayout.cshtml"; ViewData["Title"] = "Đăng ký tư vấn"; }
<section class="iz-section"><div class="iz-container iz-contact-grid"><div><p class="iz-eyebrow">BẮT ĐẦU CÙNG IZONE</p><h1>Đăng ký tư vấn lộ trình</h1><p class="iz-lead">Để lại thông tin, đội ngũ tư vấn sẽ liên hệ giúp bạn chọn lớp và thời gian học phù hợp.</p><div class="iz-contact-info"><p><b>Hotline</b><a href="tel:0969091503">0969 091 503</a></p><p><b>Email</b><a href="mailto:ielts.izone@gmail.com">ielts.izone@gmail.com</a></p><a class="iz-text-link" href="/Campuses">Xem các cơ sở đào tạo →</a></div></div><div class="iz-lead-card">@if (Model.Submitted) { <div class="iz-form-success"><h2>Cảm ơn bạn!</h2><p>IZONE đã nhận thông tin và sẽ liên hệ trong thời gian sớm nhất.</p></div> } else { <form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><label>Họ và tên<input asp-for="Input.FullName" /></label><label>Số điện thoại<input asp-for="Input.PhoneNumber" /></label><label>Email<input asp-for="Input.Email" /></label><label>Khóa học quan tâm<select asp-for="Input.InterestedCourseId"><option value="">Chọn khóa học</option>@foreach (var course in Model.Courses) { <option value="@course.Id">@course.Name</option> }</select></label><label>Mục tiêu IELTS<input asp-for="Input.Target" /></label><label>Ghi chú<textarea asp-for="Input.Note" rows="3"></textarea></label><button class="iz-btn iz-btn-primary" type="submit">Gửi đăng ký</button></form> }</div></div></section>
