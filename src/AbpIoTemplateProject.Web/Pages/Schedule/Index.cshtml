@page
@model AbpIoTemplateProject.Web.Pages.Schedule.IndexModel
@{
    Layout = "/Pages/Shared/_IzoneLayout.cshtml";
    ViewData["Title"] = "Lịch khai giảng";
}

<section class="iz-section iz-schedule-section">
    <div class="iz-container">
        <div class="iz-heading">
            <p class="iz-eyebrow">BẮT ĐẦU ĐÚNG THỜI ĐIỂM</p>
            <h1>Lịch khai giảng các lớp IELTS</h1>
            <p>Chọn lớp phù hợp rồi để lại thông tin để được tư vấn giữ chỗ.</p>
        </div>
        @if (Model.Classes.Any())
        {
            <div class="iz-schedule-table-wrap" role="region" aria-label="Lịch khai giảng" tabindex="0">
                <table class="iz-schedule-table">
                    <colgroup><col class="iz-col-course" /><col class="iz-col-code" /><col class="iz-col-date" /><col class="iz-col-time" /><col class="iz-col-teacher" /><col class="iz-col-seat" /><col class="iz-col-action" /></colgroup>
                    <thead><tr><th>Khóa học</th><th>Mã lớp</th><th>Khai giảng</th><th>Lịch học</th><th>Giảng viên</th><th>Còn chỗ</th><th><span class="visually-hidden">Đăng ký</span></th></tr></thead>
                    <tbody>
                    @foreach (var courseClass in Model.Classes)
                    {
                        <tr><td><strong>@courseClass.CourseName</strong></td><td><span class="iz-class-code">@courseClass.Code</span></td><td>@courseClass.StartDate.ToString("dd/MM/yyyy")</td><td>@courseClass.ScheduleText</td><td>@courseClass.TeacherName</td><td><span class="iz-seat-count">@courseClass.RemainingSeats chỗ</span></td><td><a class="iz-btn iz-btn-primary iz-schedule-cta" href="/Contact">Đăng ký</a></td></tr>
                    }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="iz-empty-state">Chưa có lớp đang mở đăng ký. Hãy để lại thông tin để được thông báo lịch mới.</p>
        }
    </div>
</section>
