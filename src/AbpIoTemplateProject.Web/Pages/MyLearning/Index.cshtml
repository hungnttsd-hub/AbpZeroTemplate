@page
@model AbpIoTemplateProject.Web.Pages.MyLearning.IndexModel
@{ Layout = "/Pages/Shared/_IzoneLayout.cshtml"; ViewData["Title"] = "Hồ sơ học viên"; }
<section class="iz-section"><div class="iz-container"><div class="iz-heading"><p class="iz-eyebrow">CỔNG HỌC VIÊN</p><h1>Hồ sơ & lớp học của tôi</h1><p>Cập nhật thông tin để IZONE hỗ trợ lộ trình học hiệu quả hơn.</p></div><div class="iz-two-col"><section class="iz-lead-card">@if (Model.Saved) { <p class="iz-form-success">Đã lưu hồ sơ của bạn.</p> }<form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><label>Họ và tên<input asp-for="Input.FullName" /></label><label>Số điện thoại<input asp-for="Input.PhoneNumber" /></label><label>Email<input asp-for="Input.Email" /></label><label>Trình độ hiện tại<input asp-for="Input.CurrentLevel" /></label><label>Mục tiêu<input asp-for="Input.Target" /></label><button class="iz-btn iz-btn-primary" type="submit">Lưu hồ sơ</button></form></section><section><h2>Lớp đã ghi danh</h2>@if (!Model.Enrollments.Any()) { <p>Bạn chưa có lớp nào. <a class="iz-text-link" href="/Contact">Đăng ký tư vấn →</a></p> } else { <div class="iz-resource-list">@foreach (var item in Model.Enrollments) { <article><span>@item.ClassCode · @item.StartDate.ToString("dd/MM/yyyy")</span><b>@item.CourseName</b><small>@item.ScheduleText · @item.Status · Đã thu @item.PaidAmount.ToString("N0") / @item.AgreedTuitionFee.ToString("N0") đ</small></article> }</div> }</section></div></div></section>
