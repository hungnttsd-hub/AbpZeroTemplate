@page "/cart"
@using System.Globalization
@model AbpIoTemplateProject.Web.Pages.Cart.IndexModel
@{
    Layout = "/Pages/Shared/Store/_StoreLayout.cshtml";
    ViewData["Title"] = "Giỏ hàng";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
}

<section class="store-page-hero is-compact">
    <div class="container">
        <nav class="store-breadcrumb"><a href="/">Trang chủ</a><i class="fa-solid fa-chevron-right"></i><span>Giỏ hàng</span></nav>
        <h1>Giỏ hàng của bạn</h1>
    </div>
</section>

<section class="store-checkout-section">
    <div class="container">
        @if (Model.Cart.Items.Count == 0)
        {
            <div class="store-empty-state">
                <i class="fa-solid fa-basket-shopping"></i>
                <h2>Giỏ hàng đang trống</h2>
                <p>Khám phá các sản phẩm thủy sinh được tuyển chọn cho hồ của bạn.</p>
                <a class="store-button-primary" href="/products">Tiếp tục mua sắm</a>
            </div>
        }
        else
        {
            <div class="store-cart-layout">
                <div class="store-cart-items">
                    @foreach (var item in Model.Cart.Items)
                    {
                        <article class="store-cart-item">
                            <a href="/products/@item.Slug"><img src="@(item.ImageUrl ?? "/images/store/product-placeholder.svg")" alt="@item.ProductName" /></a>
                            <div class="store-cart-item-info">
                                <small>@item.Sku</small>
                                <h2><a href="/products/@item.Slug">@item.ProductName</a></h2>
                                @if (!string.IsNullOrWhiteSpace(item.OptionSummary)) { <p>@item.OptionSummary</p> }
                                @if (!item.IsAvailable) { <span class="is-out-of-stock">Số lượng hiện không đủ</span> }
                            </div>
                            <form method="post" asp-page-handler="Update" class="store-cart-quantity">
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <label>Số lượng
                                    <input type="number" name="quantity" value="@item.Quantity" min="1" max="@item.MaximumPurchasableQuantity" />
                                </label>
                                <button type="submit">Cập nhật</button>
                            </form>
                            <div class="store-cart-line-price">
                                <strong>@string.Format(culture, "{0:N0} ₫", item.LineTotal)</strong>
                                <small>@string.Format(culture, "{0:N0} ₫", item.UnitPrice) / sản phẩm</small>
                            </div>
                            <form method="post" asp-page-handler="Remove">
                                <input type="hidden" name="itemId" value="@item.Id" />
                                <button class="store-remove-button" type="submit" aria-label="Xóa @item.ProductName"><i class="fa-solid fa-trash-can"></i></button>
                            </form>
                        </article>
                    }
                    <div class="store-cart-footer-actions">
                        <a href="/products"><i class="fa-solid fa-arrow-left"></i> Tiếp tục mua sắm</a>
                        <form method="post" asp-page-handler="Clear"><button type="submit">Xóa giỏ hàng</button></form>
                    </div>
                </div>
                <aside class="store-order-summary">
                    <h2>Tóm tắt đơn hàng</h2>
                    <form method="post" asp-page-handler="Promotion" class="store-promo-form">
                        <label>Mã ưu đãi</label>
                        <div><input name="promotionCode" value="@Model.Cart.PromotionCode" placeholder="Nhập mã" /><button type="submit">Áp dụng</button></div>
                    </form>
                    <dl>
                        <div><dt>Tạm tính</dt><dd>@string.Format(culture, "{0:N0} ₫", Model.Cart.Subtotal)</dd></div>
                        @if (Model.Cart.DiscountAmount > 0) { <div class="is-discount"><dt>Giảm giá</dt><dd>-@string.Format(culture, "{0:N0} ₫", Model.Cart.DiscountAmount)</dd></div> }
                        <div><dt>Phí giao hàng dự kiến</dt><dd>@string.Format(culture, "{0:N0} ₫", Model.Cart.EstimatedShippingFee)</dd></div>
                        <div class="store-summary-total"><dt>Tổng dự kiến</dt><dd>@string.Format(culture, "{0:N0} ₫", Model.Cart.GrandTotal)</dd></div>
                    </dl>
                    @if (Model.Cart.Items.All(x => x.IsAvailable))
                    {
                        <a class="store-button-primary w-100" href="/checkout">Tiến hành thanh toán <i class="fa-solid fa-arrow-right"></i></a>
                    }
                    else
                    {
                        <p class="store-form-error">Vui lòng điều chỉnh sản phẩm không đủ tồn kho trước khi thanh toán.</p>
                    }
                    <small class="store-secure-note"><i class="fa-solid fa-lock"></i> Thông tin của bạn được bảo vệ an toàn</small>
                </aside>
            </div>
        }
    </div>
</section>
