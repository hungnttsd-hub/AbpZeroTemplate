@page "/products/{slug}"
@using System.Globalization
@model AbpIoTemplateProject.Web.Pages.Products.DetailsModel
@{
    Layout = "/Pages/Shared/Store/_StoreLayout.cshtml";
    ViewData["Title"] = Model.Product.MetaTitle ?? Model.Product.Name;
    ViewData["MetaDescription"] = Model.Product.MetaDescription ?? Model.Product.ShortDescription;
    ViewData["CanonicalUrl"] = Model.Product.CanonicalUrl ?? $"/products/{Model.Product.Slug}";
    var culture = CultureInfo.GetCultureInfo("vi-VN");
    var displayPrice = Model.Product.SalePrice ?? Model.Product.ListPrice ?? 0;
    var mainImage = Model.Product.Images.FirstOrDefault(x => x.IsPrimary)?.Url ??
                    Model.Product.Images.FirstOrDefault()?.Url ??
                    Model.Product.ThumbnailUrl ??
                    "/images/store/product-placeholder.svg";
}
@section styles {
    <script type="application/ld+json">
        @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            new System.Collections.Generic.Dictionary<string, object?>
            {
                ["@context"] = "https://schema.org",
                ["@type"] = "Product",
                ["name"] = Model.Product.Name,
                ["sku"] = Model.Product.Sku,
                ["image"] = new[] { mainImage },
                ["description"] = Model.Product.ShortDescription,
                ["offers"] = new System.Collections.Generic.Dictionary<string, object?>
                {
                    ["@type"] = "Offer",
                    ["priceCurrency"] = "VND",
                    ["price"] = displayPrice,
                    ["availability"] = Model.Product.IsInStock ? "https://schema.org/InStock" : "https://schema.org/OutOfStock",
                    ["url"] = $"/products/{Model.Product.Slug}"
                }
            }))
    </script>
}

<section class="store-detail-section">
    <div class="container">
        <nav class="store-breadcrumb" aria-label="Breadcrumb">
            <a href="/">Trang chủ</a><i class="fa-solid fa-chevron-right"></i>
            <a href="/products">Sản phẩm</a><i class="fa-solid fa-chevron-right"></i><span>@Model.Product.Name</span>
        </nav>
        <div class="store-product-detail">
            <div class="store-product-gallery">
                <div class="store-product-main-image"><img src="@mainImage" alt="@Model.Product.Name" /></div>
                @if (Model.Product.Images.Count > 1)
                {
                    <div class="store-product-thumbnails">
                        @foreach (var image in Model.Product.Images)
                        {
                            <button type="button" data-store-product-image="@image.Url"><img src="@image.Url" alt="@image.AltText" /></button>
                        }
                    </div>
                }
            </div>
            <div class="store-product-info">
                <span class="store-section-eyebrow">@Model.Product.CategoryName</span>
                <h1>@Model.Product.Name</h1>
                <div class="store-product-meta"><span>SKU: @Model.Product.Sku</span><span>@Model.Product.BrandName</span></div>
                <div class="store-detail-price">
                    <strong>@string.Format(culture, "{0:N0} ₫", displayPrice)</strong>
                    @if (Model.Product.ListPrice.HasValue && Model.Product.SalePrice < Model.Product.ListPrice)
                    {
                        <del>@string.Format(culture, "{0:N0} ₫", Model.Product.ListPrice)</del>
                        <span>Tiết kiệm @Model.Product.DiscountPercent%</span>
                    }
                </div>
                <p class="store-product-lead">@Model.Product.ShortDescription</p>
                <div class="store-stock-message @(Model.Product.IsInStock ? "is-in-stock" : "is-out-of-stock")">
                    <i class="fa-solid @(Model.Product.IsInStock ? "fa-circle-check" : "fa-circle-xmark")"></i>
                    @(Model.Product.IsInStock ? "Sẵn hàng – giao toàn quốc" : "Tạm hết hàng")
                </div>
                @if (Model.Product.IsInStock)
                {
                    <form method="post" action="/cart?handler=add" class="store-add-form">
                        <input type="hidden" name="productId" value="@Model.Product.Id" />
                        @if (Model.Product.Variants.Count > 0)
                        {
                            <label>Chọn phiên bản
                                <select name="variantId" required>
                                    <option value="">Chọn phiên bản</option>
                                    @foreach (var variant in Model.Product.Variants.Where(x => x.IsInStock))
                                    {
                                        <option value="@variant.Id">@variant.OptionSummary – @string.Format(culture, "{0:N0} ₫", variant.SalePrice ?? variant.ListPrice)</option>
                                    }
                                </select>
                            </label>
                        }
                        <label>Số lượng
                            <input type="number" name="quantity" min="@Model.Product.MinimumOrderQuantity" max="@Model.Product.MaximumOrderQuantity" value="@Model.Product.MinimumOrderQuantity" />
                        </label>
                        <button class="store-button-primary" type="submit"><i class="fa-solid fa-cart-plus"></i> Thêm vào giỏ hàng</button>
                    </form>
                }
                <ul class="store-detail-benefits">
                    <li><i class="fa-solid fa-shield-heart"></i> Cam kết chính hãng</li>
                    <li><i class="fa-solid fa-box"></i> Đóng gói chuyên biệt</li>
                    <li><i class="fa-solid fa-headset"></i> Hỗ trợ kỹ thuật sau mua</li>
                </ul>
            </div>
        </div>

        <div class="store-product-description">
            <h2>Thông tin sản phẩm</h2>
            <div class="store-rich-text">@Html.Raw(Model.Product.Description)</div>
            @if (!string.IsNullOrWhiteSpace(Model.Product.Specifications))
            {
                <h3>Thông số kỹ thuật</h3><div class="store-rich-text">@Html.Raw(Model.Product.Specifications)</div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Product.UsageInstructions))
            {
                <h3>Hướng dẫn sử dụng</h3><div class="store-rich-text">@Html.Raw(Model.Product.UsageInstructions)</div>
            }
        </div>
    </div>
</section>

@await Html.PartialAsync("/Pages/Shared/Store/_ProductSection.cshtml",
    new AbpIoTemplateProject.Web.Pages.Shared.Store.ProductSectionViewModel(
        "Sản phẩm liên quan", "Có thể bạn cũng quan tâm", Model.Product.RelatedProducts))

@section scripts {
    <script>
        document.querySelectorAll("[data-store-product-image]").forEach(function (button) {
            button.addEventListener("click", function () {
                document.querySelector(".store-product-main-image img").src = button.dataset.storeProductImage;
            });
        });
    </script>
}
