@page "/articles"
@model AbpIoTemplateProject.Web.Pages.Articles.IndexModel
@{
    Layout = "/Pages/Shared/Store/_StoreLayout.cshtml";
    ViewData["Title"] = "Kiến thức thủy sinh";
}
<section class="store-page-hero"><div class="container"><span class="store-section-eyebrow">Cẩm nang Aqua Garden</span><h1>Kiến thức thủy sinh</h1><p>Hướng dẫn thực tế giúp bạn xây dựng và chăm sóc một hệ sinh thái khỏe đẹp.</p></div></section>
<section class="store-content-section"><div class="container">
    <div class="store-article-grid">
        @foreach (var article in Model.Articles.Items)
        {
            <article class="store-article-card">
                <a href="/articles/@article.Slug"><img src="@(article.FeaturedImageUrl ?? "/images/store/article-placeholder.svg")" alt="@article.Title" /></a>
                <div><small>@article.CategoryName · @article.PublishTime?.ToString("dd/MM/yyyy")</small><h2><a href="/articles/@article.Slug">@article.Title</a></h2><p>@article.Summary</p><a class="store-text-link" href="/articles/@article.Slug">Đọc tiếp <i class="fa-solid fa-arrow-right"></i></a></div>
            </article>
        }
    </div>
    @if (Model.PageCount > 1)
    {
        <nav class="store-pagination">
            @for (var pageIndex = 1; pageIndex <= Model.PageCount; pageIndex++)
            {
                <a class="@(pageIndex == Model.PageNumber ? "is-active" : "")" href="/articles?pageNumber=@pageIndex">@pageIndex</a>
            }
        </nav>
    }
</div></section>
