@page
@model AbpIoTemplateProject.Web.Pages.PlacementTest.IndexModel
@{
    Layout = "/Pages/Shared/_IzoneLayout.cshtml";
    ViewData["Title"] = "Kiểm tra trình độ IELTS";
}

<section class="iz-section">
    <div class="iz-container">
        <div class="iz-heading">
            <p class="iz-eyebrow">BẮT ĐẦU ĐÚNG ĐIỂM</p>
            <h1>@Model.Test?.Name</h1>
            <p>@Model.Test?.Description</p>
        </div>
        @if (Model.Test is not null)
        {
            <div class="iz-register-grid iz-placement-grid">
                <div class="iz-placement-copy">
                    <p class="iz-eyebrow">BÀI KIỂM TRA ĐẦU VÀO</p>
                    <h2>@Model.Test.DurationMinutes phút</h2>
                    <p>Bài test giúp IZONE gợi ý lộ trình khởi đầu. Kết quả chỉ mang tính định hướng; tư vấn viên sẽ xác nhận lại cùng bạn.</p>
                    <ul><li>Thực hiện trực tuyến, miễn phí</li><li>Nhận kết quả ngay khi hoàn tất</li><li>Được tư vấn lộ trình phù hợp</li></ul>
                </div>
                <form class="iz-public-form iz-placement-form" method="post">
                    <input asp-for="Input.PlacementTestId" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="iz-validation"></div>
                    <label>Họ và tên<input asp-for="Input.FullName" autocomplete="name" required /></label>
                    <label>Số điện thoại<input asp-for="Input.PhoneNumber" type="tel" autocomplete="tel" required /></label>
                    <label>Email<input asp-for="Input.Email" type="email" autocomplete="email" /></label>
                    <button class="iz-btn iz-btn-primary" type="submit">Bắt đầu kiểm tra <span aria-hidden="true">→</span></button>
                </form>
            </div>
        }
        else
        {
            <p class="iz-empty-state">Bài kiểm tra đang được cập nhật. Vui lòng quay lại sau hoặc để lại thông tin để được tư vấn.</p>
        }
    </div>
</section>
