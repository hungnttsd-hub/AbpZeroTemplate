@page
@model AbpIoTemplateProject.Web.Pages.PlacementTest.AttemptModel
@{
    Layout = "/Pages/Shared/_IzoneLayout.cshtml";
    ViewData["Title"] = "Làm bài kiểm tra";
}

<section class="iz-section"><div class="iz-container"><div class="iz-heading"><p class="iz-eyebrow">KIỂM TRA TRÌNH ĐỘ</p><h1>@(Model.Result is null ? "Hoàn thành các câu hỏi" : "Kết quả của bạn")</h1></div>
@if (Model.Result is not null)
{
    <div class="iz-register"><div class="iz-container"><h2>Gợi ý lộ trình: @Model.Result.RecommendedLevel</h2><p>Điểm bài kiểm tra: @Model.Result.Score. Đăng ký tư vấn để nhận đánh giá chi tiết hơn.</p><a class="iz-btn iz-btn-primary" href="/#dang-ky">Nhận tư vấn</a></div></div>
}
else
{
    <form method="post" class="iz-test-form"><input asp-for="AttemptId" type="hidden" />
@for (var index = 0; index < Model.Questions.Count; index++)
{
    var question = Model.Questions[index];
    <fieldset><legend>@(index + 1). @question.QuestionText</legend><input asp-for="Answers[index].PlacementQuestionId" type="hidden" />
@for (var optionIndex = 0; optionIndex < question.Options.Count; optionIndex++)
{
    <label><input type="radio" asp-for="Answers[index].Answer" value="@optionIndex" required /> @question.Options[optionIndex]</label>
}
    </fieldset>
}
        <button class="iz-btn iz-btn-primary" type="submit">Nộp bài</button>
    </form>
}
</div></section>
