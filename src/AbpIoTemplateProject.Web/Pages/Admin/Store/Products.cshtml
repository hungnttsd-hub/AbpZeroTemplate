@page "/admin/store/products"
@using System.Globalization
@model AbpIoTemplateProject.Web.Pages.Admin.Store.ProductsModel
@{ Layout = "/Pages/Shared/Store/_AdminLayout.cshtml"; ViewData["Title"] = "Sản phẩm"; var culture = CultureInfo.GetCultureInfo("vi-VN"); }
<div class="store-admin-title"><div><span>Catalog</span><h1>Quản lý sản phẩm</h1></div><button class="store-admin-primary" data-bs-toggle="collapse" data-bs-target="#productForm"><i class="fa-solid fa-plus"></i> Thêm sản phẩm</button></div>
<div class="collapse store-admin-card store-admin-form-card" id="productForm">
<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="store-admin-form-grid">
        <label>Mã sản phẩm<input asp-for="Input.Code" /></label><label>SKU<input asp-for="Input.Sku" /></label>
        <label class="is-wide">Tên sản phẩm<input asp-for="Input.Name" /></label><label>Slug<input asp-for="Input.Slug" /></label>
        <label>Loại<select asp-for="Input.Type" asp-items="Html.GetEnumSelectList<ProductType>()"></select></label>
        <label>Danh mục<select asp-for="Input.CategoryId"><option value="">Chọn danh mục</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select></label>
        <label>Thương hiệu<select asp-for="Input.BrandId"><option value="">Không chọn</option>@foreach(var x in Model.Brands){<option value="@x.Id">@x.Name</option>}</select></label>
        <label>Nhà cung cấp<select asp-for="Input.SupplierId"><option value="">Không chọn</option>@foreach(var x in Model.Suppliers){<option value="@x.Id">@x.Name</option>}</select></label>
        <label>Giá bán<input asp-for="Input.SalePrice" type="number" min="0" /></label><label>Giá niêm yết<input asp-for="Input.ListPrice" type="number" min="0" /></label>
        <label>Giá vốn<input asp-for="Input.CostPrice" type="number" min="0" /></label><label>Thuế (%)<input asp-for="Input.TaxRate" type="number" min="0" max="100" /></label>
        <label class="is-wide">Ảnh đại diện<input asp-for="Input.ThumbnailUrl" placeholder="/images/store/product-placeholder.svg" /></label>
        <label class="is-full">Mô tả ngắn<textarea asp-for="Input.ShortDescription"></textarea></label>
        <label class="is-full">Mô tả chi tiết<textarea asp-for="Input.Description" rows="5"></textarea></label>
        <label>Đơn vị<input asp-for="Input.Unit" /></label><label>Khối lượng (kg)<input asp-for="Input.Weight" type="number" min="0" step=".01" /></label>
        <label>SL tối thiểu<input asp-for="Input.MinimumOrderQuantity" type="number" min="1" /></label><label>SL tối đa<input asp-for="Input.MaximumOrderQuantity" type="number" min="1" /></label>
    </div>
    <div class="store-admin-checks"><label><input asp-for="Input.IsActive" /> Đang hoạt động</label><label><input asp-for="Input.IsVisible" /> Hiển thị</label><label><input asp-for="Input.IsFeatured" /> Nổi bật</label><label><input asp-for="Input.IsNew" /> Sản phẩm mới</label><label><input asp-for="Input.IsBestSeller" /> Bán chạy</label><label><input asp-for="Input.AllowBackorder" /> Cho phép đặt trước</label></div>
    <button class="store-admin-primary" type="submit">Lưu sản phẩm</button>
</form></div>
<div class="store-admin-content-grid">
    <section class="store-admin-card">
        <div class="store-admin-card-head"><h2>Thêm phiên bản</h2></div>
        <form method="post" asp-page-handler="Variant" class="store-admin-compact-form">
            <select name="input.ProductId" required><option value="">Chọn sản phẩm biến thể</option>@foreach(var p in Model.Products.Items.Where(x => x.HasVariants)){<option value="@p.Id">@p.Name</option>}</select>
            <input name="input.Name" placeholder="Tên phiên bản" required />
            <input name="input.Sku" placeholder="SKU phiên bản" required />
            <input name="input.OptionSummary" placeholder="Ví dụ: Màu đỏ · 60 cm" required />
            <input name="input.SalePrice" type="number" min="0" placeholder="Giá bán" />
            <input name="input.ListPrice" type="number" min="0" placeholder="Giá niêm yết" />
            <button class="store-admin-primary" type="submit">Thêm phiên bản</button>
        </form>
    </section>
    <section class="store-admin-card">
        <div class="store-admin-card-head"><h2>Thêm hình ảnh</h2></div>
        <form method="post" asp-page-handler="Image" class="store-admin-compact-form">
            <select name="input.ProductId" required><option value="">Chọn sản phẩm</option>@foreach(var p in Model.Products.Items){<option value="@p.Id">@p.Name</option>}</select>
            <input name="input.Url" placeholder="URL hình ảnh" required />
            <input name="input.AltText" placeholder="Mô tả ảnh" required />
            <input name="input.DisplayOrder" type="number" value="0" />
            <label><input name="input.IsPrimary" type="checkbox" value="true" /> Ảnh chính</label>
            <button class="store-admin-primary" type="submit">Thêm hình ảnh</button>
        </form>
    </section>
</div>
<section class="store-admin-card">
<div class="store-admin-card-head"><h2>@Model.Products.TotalCount sản phẩm</h2></div>
<div class="store-admin-table-wrap"><table><thead><tr><th>Sản phẩm</th><th>SKU</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th></tr></thead><tbody>
@foreach(var p in Model.Products.Items){<tr><td><div class="store-admin-product"><img src="@(p.ThumbnailUrl ?? "/images/store/product-placeholder.svg")" alt="" /><span><strong>@p.Name</strong><small>@p.Code</small></span></div></td><td>@p.Sku</td><td>@p.CategoryName</td><td>@string.Format(culture, "{0:N0} ₫", p.SalePrice ?? p.ListPrice)</td><td><span class="store-admin-status @(p.IsInStock ? "" : "is-danger")">@(p.IsInStock ? "Còn hàng" : "Hết hàng")</span></td></tr>}
</tbody></table></div></section>
