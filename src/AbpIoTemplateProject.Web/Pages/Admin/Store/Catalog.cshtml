@page "/admin/store/catalog"
@model AbpIoTemplateProject.Web.Pages.Admin.Store.CatalogModel
@{ Layout = "/Pages/Shared/Store/_AdminLayout.cshtml"; ViewData["Title"] = "Danh mục & đối tác"; }
<div class="store-admin-title"><div><span>Catalog</span><h1>Danh mục & đối tác</h1></div></div>
<div class="store-admin-three-columns">
<section class="store-admin-card"><div class="store-admin-card-head"><h2>Danh mục</h2></div><form method="post" asp-page-handler="Category" class="store-admin-compact-form"><input name="input.Name" placeholder="Tên danh mục" required/><input name="input.Slug" placeholder="slug-danh-muc" required/><select name="input.ParentId"><option value="">Danh mục gốc</option>@foreach(var x in Model.Categories){<option value="@x.Id">@x.Name</option>}</select><label><input type="checkbox" name="input.IsFeatured" value="true"/> Nổi bật</label><input type="hidden" name="input.IsActive" value="true"/><button class="store-admin-primary" type="submit">Thêm danh mục</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Categories){<li><span><strong>@x.Name</strong><small>@x.Slug</small></span><b>@x.ProductCount</b></li>}</ul></section>
<section class="store-admin-card"><div class="store-admin-card-head"><h2>Thương hiệu</h2></div><form method="post" asp-page-handler="Brand" class="store-admin-compact-form"><input name="input.Name" placeholder="Tên thương hiệu" required/><input name="input.Slug" placeholder="slug-thuong-hieu" required/><input name="input.LogoUrl" placeholder="URL logo"/><label><input type="checkbox" name="input.IsFeatured" value="true"/> Nổi bật</label><input type="hidden" name="input.IsActive" value="true"/><button class="store-admin-primary" type="submit">Thêm thương hiệu</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Brands){<li><span><strong>@x.Name</strong><small>@x.Slug</small></span></li>}</ul></section>
<section class="store-admin-card"><div class="store-admin-card-head"><h2>Nhà cung cấp</h2></div><form method="post" asp-page-handler="Supplier" class="store-admin-compact-form"><input name="input.Code" placeholder="Mã NCC" required/><input name="input.Name" placeholder="Tên nhà cung cấp" required/><input name="input.Phone" placeholder="Điện thoại"/><input name="input.Email" type="email" placeholder="Email"/><input type="hidden" name="input.IsActive" value="true"/><button class="store-admin-primary" type="submit">Thêm nhà cung cấp</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Suppliers){<li><span><strong>@x.Name</strong><small>@x.Code</small></span></li>}</ul></section>
</div>
