@page "/admin/store/content"
@model AbpIoTemplateProject.Web.Pages.Admin.Store.ContentModel
@{ Layout = "/Pages/Shared/Store/_AdminLayout.cshtml"; ViewData["Title"] = "Nội dung & ưu đãi"; }
<div class="store-admin-title"><div><span>Marketing</span><h1>Nội dung & ưu đãi</h1></div></div>
<div class="store-admin-content-grid">
<section class="store-admin-card"><div class="store-admin-card-head"><h2>Khuyến mãi</h2></div><form method="post" asp-page-handler="Promotion" class="store-admin-compact-form"><input name="input.Code" placeholder="Mã ưu đãi" required/><input name="input.Name" placeholder="Tên chương trình" required/><select name="input.Type" asp-items="Html.GetEnumSelectList<PromotionType>()"></select><input name="input.Value" type="number" min="0" placeholder="Giá trị" required/><input name="input.MinimumOrderAmount" type="number" min="0" placeholder="Đơn tối thiểu"/><label>Bắt đầu<input name="input.StartTime" type="datetime-local" value="@Model.DefaultStart.ToString("yyyy-MM-ddTHH:mm")"/></label><label>Kết thúc<input name="input.EndTime" type="datetime-local" value="@Model.DefaultEnd.ToString("yyyy-MM-ddTHH:mm")"/></label><input type="hidden" name="input.IsActive" value="true"/><button class="store-admin-primary" type="submit">Tạo khuyến mãi</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Promotions){<li><span><strong>@x.Code · @x.Name</strong><small>@x.Type @x.Value · đã dùng @x.UsageCount</small></span><b>@(x.IsActive ? "Bật" : "Tắt")</b></li>}</ul></section>
<section class="store-admin-card"><div class="store-admin-card-head"><h2>Banner</h2></div><form method="post" asp-page-handler="Banner" class="store-admin-compact-form"><input name="input.Title" placeholder="Tiêu đề" required/><input name="input.DesktopImageUrl" placeholder="URL ảnh desktop" required/><input name="input.MobileImageUrl" placeholder="URL ảnh mobile" required/><input name="input.ButtonText" placeholder="Nhãn nút"/><input name="input.TargetUrl" placeholder="Liên kết"/><input type="hidden" name="input.IsActive" value="true"/><button class="store-admin-primary" type="submit">Thêm banner</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Banners){<li><span><strong>@x.Title</strong><small>@x.TargetUrl</small></span></li>}</ul></section>
<section class="store-admin-card is-wide"><div class="store-admin-card-head"><h2>Bài viết</h2></div><form method="post" asp-page-handler="Article" class="store-admin-form-grid"><label>Chuyên mục<select name="input.ArticleCategoryId" required><option value="">Chọn chuyên mục</option>@foreach(var x in Model.ArticleCategories){<option value="@x.Id">@x.Name</option>}</select></label><label>Tiêu đề<input name="input.Title" required/></label><label>Slug<input name="input.Slug" required/></label><label>Tác giả<input name="input.AuthorName" value="Aqua Garden" required/></label><label class="is-full">Tóm tắt<textarea name="input.Summary" required></textarea></label><label class="is-full">Nội dung HTML<textarea name="input.Content" rows="8" required></textarea></label><label><input type="checkbox" name="input.IsFeatured" value="true"/> Nổi bật</label><label><input type="checkbox" name="input.Publish" value="true"/> Xuất bản ngay</label><button class="store-admin-primary" type="submit">Lưu bài viết</button></form><ul class="store-admin-simple-list">@foreach(var x in Model.Articles.Items){<li><span><strong>@x.Title</strong><small>@x.CategoryName · @(x.PublishTime.HasValue ? "Đã xuất bản" : "Bản nháp")</small></span></li>}</ul></section>
</div>
