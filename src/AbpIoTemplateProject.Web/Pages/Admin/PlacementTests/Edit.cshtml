@page
@model AbpIoTemplateProject.Web.Pages.Admin.PlacementTests.EditModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = Model.Id.HasValue ? "Cập nhật đề kiểm tra" : "Tạo đề kiểm tra"; }
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Tên đề</label><input class="form-control" asp-for="Input.Name" /></div><div class="col-md-4"><label class="form-label">Slug</label><input class="form-control" asp-for="Input.Slug" /></div><div class="col-md-8"><label class="form-label">Mô tả</label><textarea class="form-control" asp-for="Input.Description" rows="3"></textarea></div><div class="col-md-2"><label class="form-label">Thời lượng (phút)</label><input class="form-control" asp-for="Input.DurationMinutes" /></div><div class="col-md-2"><label class="form-label">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.PlacementTestStatus>()"></select></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu đề</button><a class="btn btn-outline-secondary" href="/Admin/PlacementTests">Hủy</a></div></form></section>
