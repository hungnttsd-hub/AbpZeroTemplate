@page
@model AbpIoTemplateProject.Web.Pages.Admin.PlacementTests.QuestionsModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Ngân hàng câu hỏi"; }
<section class="edu-card edu-form"><div class="edu-card-header"><h2>@(Model.Id.HasValue ? "Cập nhật câu hỏi" : "Thêm câu hỏi")</h2><a class="btn btn-outline-secondary" href="/Admin/PlacementTests">Quay lại danh sách đề</a></div><form method="post" asp-page-handler="Save"><input type="hidden" asp-for="TestId" /><input type="hidden" asp-for="Id" /><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-12"><label class="form-label">Nội dung câu hỏi</label><textarea class="form-control" asp-for="Input.QuestionText" rows="3"></textarea></div><div class="col-12"><label class="form-label">Đáp án (JSON)</label><textarea class="form-control" asp-for="Input.OptionsJson" rows="4" placeholder='["A", "B", "C", "D"]'></textarea><small class="text-muted">Mỗi phương án là một chuỗi trong mảng JSON. Đáp án đúng là chỉ số 0, 1, 2…</small></div><div class="col-md-4"><label class="form-label">Đáp án đúng (chỉ số)</label><input class="form-control" asp-for="Input.CorrectAnswer" /></div><div class="col-md-4"><label class="form-label">Điểm</label><input class="form-control" asp-for="Input.Score" /></div><div class="col-md-4"><label class="form-label">Thứ tự</label><input class="form-control" asp-for="Input.DisplayOrder" /></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu câu hỏi</button><a class="btn btn-outline-secondary" href="/Admin/PlacementTests/Questions?testId=@Model.TestId">Tạo mới</a></div></form></section><section class="edu-card mt-4"><h2>Danh sách câu hỏi</h2><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Thứ tự</th><th>Nội dung</th><th>Đáp án</th><th>Điểm</th><th></th></tr></thead><tbody>@foreach (var question in Model.Questions) { <tr><td>@question.DisplayOrder</td><td>@question.QuestionText</td><td>@question.CorrectAnswer</td><td>@question.Score</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/PlacementTests/Questions?testId=@Model.TestId&id=@question.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete"><input type="hidden" name="testId" value="@Model.TestId" /><input type="hidden" name="id" value="@question.Id" /><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div></section>
