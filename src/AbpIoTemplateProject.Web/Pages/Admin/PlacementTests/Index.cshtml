@page
@model AbpIoTemplateProject.Web.Pages.Admin.PlacementTests.IndexModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Kiểm tra trình độ"; }
<section class="edu-card"><div class="edu-card-header"><h2>Đề kiểm tra</h2><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/Placement-Test" target="_blank">Xem public</a><a class="btn btn-izone" href="/Admin/PlacementTests/Edit">Tạo đề mới</a></div></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Tên đề</th><th>Thời lượng</th><th>Câu hỏi</th><th>Lượt làm</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var test in Model.Tests) { <tr><td><strong>@test.Name</strong><br/><small>@test.Slug</small></td><td>@test.DurationMinutes phút</td><td>@test.QuestionCount</td><td>@test.AttemptCount</td><td>@test.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-primary" href="/Admin/PlacementTests/Questions?testId=@test.Id">Câu hỏi</a><a class="btn btn-sm btn-outline-secondary" href="/Admin/PlacementTests/Edit?id=@test.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@test.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div></section>
