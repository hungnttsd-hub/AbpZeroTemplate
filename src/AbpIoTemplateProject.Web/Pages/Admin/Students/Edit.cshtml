@page
@model AbpIoTemplateProject.Web.Pages.Admin.Students.EditModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = Model.Id.HasValue ? "Cập nhật học viên" : "Thêm học viên"; }
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Họ và tên</label><input class="form-control" asp-for="Input.FullName" /></div><div class="col-md-6"><label class="form-label">Số điện thoại</label><input class="form-control" asp-for="Input.PhoneNumber" /></div><div class="col-md-6"><label class="form-label">Email</label><input class="form-control" asp-for="Input.Email" /></div><div class="col-md-3"><label class="form-label">Trình độ hiện tại</label><input class="form-control" asp-for="Input.CurrentLevel" /></div><div class="col-md-3"><label class="form-label">Mục tiêu</label><input class="form-control" asp-for="Input.Target" /></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu học viên</button><a class="btn btn-outline-secondary" href="/Admin/Students">Hủy</a></div></form></section>
