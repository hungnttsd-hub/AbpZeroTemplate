@page
@model AbpIoTemplateProject.Web.Pages.Admin.Students.IndexModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Học viên"; }
<section class="edu-card"><div class="edu-card-header"><h2>Hồ sơ học viên</h2><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/Admin/Enrollments">Ghi danh</a><a class="btn btn-izone" href="/Admin/Students/Edit">Thêm học viên</a></div></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Họ tên</th><th>Liên hệ</th><th>Trình độ / mục tiêu</th><th>Lớp đang/đã học</th><th></th></tr></thead><tbody>@foreach (var student in Model.Students) { <tr><td><strong>@student.FullName</strong></td><td>@student.PhoneNumber<br/><small>@student.Email</small></td><td>@student.CurrentLevel → @student.Target</td><td>@student.EnrollmentCount</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/Students/Edit?id=@student.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@student.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div>@if (!Model.Students.Any()) { <p class="edu-empty">Chưa có hồ sơ học viên. Hãy chuyển lead đủ điều kiện thành học viên tại đây.</p> }</section>
