@page
@model AbpIoTemplateProject.Web.Pages.Admin.Leads.IndexModel
@{
    Layout = "/Pages/Shared/_EducationAdminLayout.cshtml";
    ViewData["Title"] = "Lead tư vấn";
}
<section class="edu-card"><div class="edu-card-header"><h2>Khách hàng cần tư vấn</h2><span class="edu-badge">@Model.Leads.Count lead</span></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Thời gian</th><th>Học viên</th><th>Liên hệ</th><th>Quan tâm</th><th>Mục tiêu</th><th>Trạng thái</th></tr></thead><tbody>@foreach (var lead in Model.Leads) { <tr><td>@lead.CreationTime.ToString("dd/MM HH:mm")</td><td><strong>@lead.FullName</strong></td><td><a href="tel:@lead.PhoneNumber">@lead.PhoneNumber</a><br /><small>@lead.Email</small></td><td>@lead.InterestedCourseName</td><td>@lead.Target</td><td><form method="post" asp-page-handler="Status" class="d-flex gap-1"><input asp-for="LeadId" type="hidden" value="@lead.Id" /><select asp-for="Status" class="form-select form-select-sm"><option value="New" selected="@(lead.Status == AbpIoTemplateProject.Education.LeadStatus.New)">Mới</option><option value="Contacted" selected="@(lead.Status == AbpIoTemplateProject.Education.LeadStatus.Contacted)">Đã liên hệ</option><option value="Qualified" selected="@(lead.Status == AbpIoTemplateProject.Education.LeadStatus.Qualified)">Đủ điều kiện</option><option value="Converted" selected="@(lead.Status == AbpIoTemplateProject.Education.LeadStatus.Converted)">Đã chuyển đổi</option><option value="Lost" selected="@(lead.Status == AbpIoTemplateProject.Education.LeadStatus.Lost)">Không phù hợp</option></select><button class="btn btn-sm btn-izone" type="submit">Lưu</button></form></td></tr> }</tbody></table></div>@if (Model.Leads.Count == 0) { <p class="edu-empty">Chưa có lead tư vấn.</p> }</section>
