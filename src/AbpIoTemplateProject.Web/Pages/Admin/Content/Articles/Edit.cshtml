@page
@model AbpIoTemplateProject.Web.Pages.Admin.Content.Articles.EditModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = Model.Id.HasValue ? "Cập nhật bài viết" : "Viết bài mới"; }
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Tiêu đề</label><input class="form-control" asp-for="Input.Title" /></div><div class="col-md-4"><label class="form-label">Danh mục</label><select class="form-select" asp-for="Input.CategoryId"><option value="">Chưa phân loại</option>@foreach (var category in Model.Categories) { <option value="@category.Id">@category.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Slug URL</label><input class="form-control" asp-for="Input.Slug" /></div><div class="col-md-3"><label class="form-label">Tác giả</label><input class="form-control" asp-for="Input.AuthorName" /></div><div class="col-md-3"><label class="form-label">Ngày xuất bản</label><input class="form-control" asp-for="Input.PublishedAt" /></div><div class="col-12"><label class="form-label">Mô tả ngắn</label><textarea class="form-control" asp-for="Input.Excerpt" rows="2"></textarea></div><div class="col-12"><label class="form-label">Nội dung (HTML được hỗ trợ)</label><textarea class="form-control" asp-for="Input.Content" rows="13"></textarea></div><div class="col-md-6"><label class="form-label">URL ảnh bìa</label><input class="form-control" asp-for="Input.CoverImageUrl" /></div><div class="col-md-3"><label class="form-label">SEO title</label><input class="form-control" asp-for="Input.MetaTitle" /></div><div class="col-md-3"><label class="form-label">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.PublicationStatus>()"></select></div><div class="col-12 form-check ms-2"><input class="form-check-input" asp-for="Input.IsFeatured" /><label class="form-check-label" asp-for="Input.IsFeatured">Hiển thị nổi bật</label></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu bài viết</button><a class="btn btn-outline-secondary" href="/Admin/Content/Articles">Hủy</a></div></form></section>
