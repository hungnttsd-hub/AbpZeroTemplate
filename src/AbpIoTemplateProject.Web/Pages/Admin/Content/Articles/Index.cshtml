@page
@model AbpIoTemplateProject.Web.Pages.Admin.Content.Articles.IndexModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Kho kiến thức"; }
<section class="edu-card"><div class="edu-card-header"><h2>Bài viết</h2><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/Admin/Content/Documents">Tài liệu</a><a class="btn btn-izone" href="/Admin/Content/Articles/Edit">Viết bài mới</a></div></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Tiêu đề</th><th>Danh mục</th><th>Xuất bản</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var article in Model.Articles) { <tr><td><strong>@article.Title</strong>@if (article.IsFeatured) { <span class="edu-badge ms-1">Nổi bật</span> }<br/><small>/knowledge/@article.Slug</small></td><td>@article.CategoryName</td><td>@(article.PublishedAt?.ToString("dd/MM/yyyy") ?? "—")</td><td>@article.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/Content/Articles/Edit?id=@article.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@article.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div>@if (!Model.Articles.Any()) { <p class="edu-empty">Chưa có bài viết.</p> }</section>
