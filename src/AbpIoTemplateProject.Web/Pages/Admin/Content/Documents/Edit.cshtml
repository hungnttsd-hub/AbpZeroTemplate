@page
@model AbpIoTemplateProject.Web.Pages.Admin.Content.Documents.EditModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = Model.Id.HasValue ? "Cập nhật tài liệu" : "Thêm tài liệu"; }
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label class="form-label">Tên tài liệu</label><input class="form-control" asp-for="Input.Name" /></div><div class="col-md-4"><label class="form-label">Slug URL</label><input class="form-control" asp-for="Input.Slug" /></div><div class="col-12"><label class="form-label">Mô tả</label><textarea class="form-control" asp-for="Input.Description" rows="3"></textarea></div><div class="col-md-6"><label class="form-label">URL file tải xuống</label><input class="form-control" asp-for="Input.FileUrl" placeholder="https://... hoặc /uploads/..." /></div><div class="col-md-6"><label class="form-label">URL ảnh bìa</label><input class="form-control" asp-for="Input.CoverImageUrl" /></div><div class="col-md-4"><label class="form-label">Kỹ năng</label><input class="form-control" asp-for="Input.Skill" placeholder="Listening, Reading..." /></div><div class="col-md-4"><label class="form-label">Trình độ</label><input class="form-control" asp-for="Input.Level" /></div><div class="col-md-2"><label class="form-label">Quyền truy cập</label><select class="form-select" asp-for="Input.AccessLevel" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.DocumentAccessLevel>()"></select></div><div class="col-md-2"><label class="form-label">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.PublicationStatus>()"></select></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu tài liệu</button><a class="btn btn-outline-secondary" href="/Admin/Content/Documents">Hủy</a></div></form></section>
