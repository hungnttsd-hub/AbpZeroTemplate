@page
@model AbpIoTemplateProject.Web.Pages.Admin.Content.Documents.IndexModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Tài liệu học tập"; }
<section class="edu-card"><div class="edu-card-header"><h2>Kho tài liệu</h2><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/Admin/Content/Articles">Bài viết</a><a class="btn btn-izone" href="/Admin/Content/Documents/Edit">Thêm tài liệu</a></div></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Tên tài liệu</th><th>Kỹ năng / trình độ</th><th>Lượt tải</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var document in Model.Documents) { <tr><td><strong>@document.Name</strong><br/><small>/documents/@document.Slug</small></td><td>@document.Skill / @document.Level</td><td>@document.DownloadCount</td><td>@document.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/Content/Documents/Edit?id=@document.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@document.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div>@if (!Model.Documents.Any()) { <p class="edu-empty">Chưa có tài liệu.</p> }</section>
