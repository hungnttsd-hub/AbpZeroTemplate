@page
@model AbpIoTemplateProject.Web.Pages.Admin.Teachers.EditModel
@{
    Layout = "/Pages/Shared/_EducationAdminLayout.cshtml";
    ViewData["Title"] = Model.Id.HasValue ? "Cập nhật giảng viên" : "Thêm giảng viên";
}
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-8"><label class="form-label" asp-for="Input.FullName">Họ và tên</label><input class="form-control" asp-for="Input.FullName" /></div><div class="col-md-4"><label class="form-label" asp-for="Input.Slug">Slug URL</label><input class="form-control" asp-for="Input.Slug" /></div><div class="col-md-6"><label class="form-label" asp-for="Input.Title">Chức danh</label><input class="form-control" asp-for="Input.Title" /></div><div class="col-md-6"><label class="form-label" asp-for="Input.Status">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.PublicationStatus>()"></select></div><div class="col-12"><label class="form-label" asp-for="Input.Credentials">Chứng chỉ / thành tích</label><textarea class="form-control" asp-for="Input.Credentials" rows="2"></textarea></div><div class="col-12"><label class="form-label" asp-for="Input.Biography">Giới thiệu</label><textarea class="form-control" asp-for="Input.Biography" rows="6"></textarea></div><div class="col-12"><label class="form-label" asp-for="Input.AvatarUrl">URL ảnh đại diện</label><input class="form-control" asp-for="Input.AvatarUrl" /></div><div class="col-12 form-check ms-2"><input class="form-check-input" asp-for="Input.IsFeatured" /><label class="form-check-label" asp-for="Input.IsFeatured">Hiển thị nổi bật</label></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu giảng viên</button><a class="btn btn-outline-secondary" href="/Admin/Teachers">Hủy</a></div></form></section>
