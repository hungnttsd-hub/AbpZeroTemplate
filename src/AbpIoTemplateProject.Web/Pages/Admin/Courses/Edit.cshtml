@page
@model AbpIoTemplateProject.Web.Pages.Admin.Courses.EditModel
@{
    Layout = "/Pages/Shared/_EducationAdminLayout.cshtml";
    ViewData["Title"] = Model.Id.HasValue ? "Cập nhật khóa học" : "Thêm khóa học";
}
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-4"><label class="form-label" asp-for="Input.Code">Mã khóa học</label><input class="form-control" asp-for="Input.Code" /></div><div class="col-md-8"><label class="form-label" asp-for="Input.Name">Tên khóa học</label><input class="form-control" asp-for="Input.Name" /></div><div class="col-12"><label class="form-label" asp-for="Input.Slug">Slug URL</label><input class="form-control" asp-for="Input.Slug" /></div><div class="col-md-6"><label class="form-label" asp-for="Input.EntryLevel">Đầu vào</label><input class="form-control" asp-for="Input.EntryLevel" /></div><div class="col-md-6"><label class="form-label" asp-for="Input.TargetLevel">Đầu ra</label><input class="form-control" asp-for="Input.TargetLevel" /></div><div class="col-md-4"><label class="form-label" asp-for="Input.SessionCount">Số buổi</label><input class="form-control" asp-for="Input.SessionCount" /></div><div class="col-md-4"><label class="form-label" asp-for="Input.DurationHours">Số giờ</label><input class="form-control" asp-for="Input.DurationHours" /></div><div class="col-md-4"><label class="form-label" asp-for="Input.TuitionFee">Học phí</label><input class="form-control" asp-for="Input.TuitionFee" /></div><div class="col-md-6"><label class="form-label" asp-for="Input.DeliveryMode">Hình thức học</label><select class="form-select" asp-for="Input.DeliveryMode" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.CourseDeliveryMode>()"></select></div><div class="col-md-6"><label class="form-label" asp-for="Input.Status">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.PublicationStatus>()"></select></div><div class="col-12"><label class="form-label" asp-for="Input.ShortDescription">Mô tả ngắn</label><textarea class="form-control" asp-for="Input.ShortDescription" rows="2"></textarea></div><div class="col-12"><label class="form-label" asp-for="Input.Description">Nội dung chi tiết</label><textarea class="form-control" asp-for="Input.Description" rows="6"></textarea></div><div class="col-12"><label class="form-label" asp-for="Input.CoverImageUrl">URL ảnh bìa</label><input class="form-control" asp-for="Input.CoverImageUrl" /></div><div class="col-12 form-check ms-2"><input class="form-check-input" asp-for="Input.IsFeatured" /><label class="form-check-label" asp-for="Input.IsFeatured">Hiển thị nổi bật</label></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu khóa học</button><a class="btn btn-outline-secondary" href="/Admin/Courses">Hủy</a></div></form></section>
