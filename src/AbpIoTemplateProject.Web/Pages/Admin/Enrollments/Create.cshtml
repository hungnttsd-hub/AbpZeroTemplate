@page
@model AbpIoTemplateProject.Web.Pages.Admin.Enrollments.CreateModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Tạo ghi danh"; }
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-6"><label class="form-label">Học viên</label><select class="form-select" asp-for="Input.StudentId"><option value="">Chọn học viên</option>@foreach (var item in Model.Students) { <option value="@item.Id">@item.FullName — @item.PhoneNumber</option> }</select></div><div class="col-md-6"><label class="form-label">Lớp khai giảng</label><select class="form-select" asp-for="Input.CourseClassId"><option value="">Chọn lớp</option>@foreach (var item in Model.Classes) { <option value="@item.Id">@item.Code — @item.CourseName (@item.EnrolledCount/@item.Capacity)</option> }</select></div><div class="col-md-4"><label class="form-label">Học phí thỏa thuận</label><input class="form-control" asp-for="Input.AgreedTuitionFee" /></div><div class="col-md-4"><label class="form-label">Đã thu</label><input class="form-control" asp-for="Input.PaidAmount" /></div><div class="col-md-4"><label class="form-label">Trạng thái</label><input class="form-control" asp-for="Input.Status" /></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Xác nhận ghi danh</button><a class="btn btn-outline-secondary" href="/Admin/Enrollments">Hủy</a></div></form></section>
