@page
@model AbpIoTemplateProject.Web.Pages.Admin.Enrollments.IndexModel
@{ Layout = "/Pages/Shared/_EducationAdminLayout.cshtml"; ViewData["Title"] = "Ghi danh & học phí"; }
<section class="edu-card"><div class="edu-card-header"><h2>Danh sách ghi danh</h2><a class="btn btn-izone" href="/Admin/Enrollments/Create">Tạo ghi danh</a></div><div class="table-responsive"><table class="table edu-table"><thead><tr><th>Học viên</th><th>Lớp / khóa</th><th>Ngày ghi danh</th><th>Học phí</th><th>Đã thu</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var enrollment in Model.Enrollments) { <tr><td><strong>@enrollment.StudentName</strong></td><td>@enrollment.ClassCode<br/><small>@enrollment.CourseName</small></td><td>@enrollment.EnrolledAt.ToString("dd/MM/yyyy")</td><td>@enrollment.AgreedTuitionFee.ToString("N0") đ</td><td>@enrollment.PaidAmount.ToString("N0") đ</td><td>@enrollment.Status</td><td class="text-end"><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@enrollment.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Hủy ghi danh</button></form></td></tr> }</tbody></table></div>@if (!Model.Enrollments.Any()) { <p class="edu-empty">Chưa có học viên nào được ghi danh.</p> }</section>
