@page
@model AbpIoTemplateProject.Web.Pages.Admin.Classes.EditModel
@{
    Layout = "/Pages/Shared/_EducationAdminLayout.cshtml";
    ViewData["Title"] = Model.Id.HasValue ? "Cập nhật lớp" : "Thêm lớp khai giảng";
}
<section class="edu-card edu-form"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="row g-3"><div class="col-md-4"><label class="form-label">Mã lớp</label><input class="form-control" asp-for="Input.Code" /></div><div class="col-md-8"><label class="form-label">Khóa học</label><select class="form-select" asp-for="Input.CourseId"><option value="">Chọn khóa học</option>@foreach (var item in Model.Courses) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Giảng viên</label><select class="form-select" asp-for="Input.TeacherId"><option value="">Chưa phân công</option>@foreach (var item in Model.Teachers) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Cơ sở</label><select class="form-select" asp-for="Input.CampusId"><option value="">Chưa xác định</option>@foreach (var item in Model.Campuses) { <option value="@item.Id">@item.Name</option> }</select></div><div class="col-md-6"><label class="form-label">Ngày khai giảng</label><input class="form-control" asp-for="Input.StartDate" /></div><div class="col-md-6"><label class="form-label">Ngày kết thúc</label><input class="form-control" asp-for="Input.EndDate" /></div><div class="col-md-8"><label class="form-label">Lịch học</label><input class="form-control" asp-for="Input.ScheduleText" placeholder="Ví dụ: Thứ 2 - 4 - 6, 19:00 - 21:00" /></div><div class="col-md-2"><label class="form-label">Sức chứa</label><input class="form-control" asp-for="Input.Capacity" /></div><div class="col-md-2"><label class="form-label">Trạng thái</label><select class="form-select" asp-for="Input.Status" asp-items="Html.GetEnumSelectList<AbpIoTemplateProject.Education.CourseClassStatus>()"></select></div></div><div class="edu-form-actions"><button class="btn btn-izone" type="submit">Lưu lớp</button><a class="btn btn-outline-secondary" href="/Admin/Classes">Hủy</a></div></form></section>
