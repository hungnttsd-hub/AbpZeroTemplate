@page
@model AbpIoTemplateProject.Web.Pages.Admin.Classes.IndexModel
@{
    Layout = "/Pages/Shared/_EducationAdminLayout.cshtml";
    ViewData["Title"] = "Lớp khai giảng";
}
<section class="edu-card">
    <div class="edu-card-header"><h2>Lịch lớp và sức chứa</h2><div class="d-flex gap-2"><a class="btn btn-outline-secondary" href="/Schedule" target="_blank">Xem trang công khai</a><a class="btn btn-izone" href="/Admin/Classes/Edit">Thêm lớp</a></div></div>
    <div class="table-responsive"><table class="table edu-table"><thead><tr><th>Mã lớp</th><th>Khóa học</th><th>Khai giảng</th><th>Giảng viên</th><th>Cơ sở</th><th>Sĩ số</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach (var courseClass in Model.Classes) { <tr><td>@courseClass.Code</td><td><strong>@courseClass.CourseName</strong></td><td>@courseClass.StartDate.ToString("dd/MM/yyyy")</td><td>@courseClass.TeacherName</td><td>@courseClass.CampusName</td><td>@courseClass.EnrolledCount / @courseClass.Capacity</td><td>@courseClass.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-secondary" href="/Admin/Classes/Edit?id=@courseClass.Id">Sửa</a><form class="d-inline" method="post" asp-page-handler="Delete" asp-route-id="@courseClass.Id"><button class="btn btn-sm btn-outline-danger" type="submit">Xóa</button></form></td></tr> }</tbody></table></div>
    @if (Model.Classes.Count == 0) { <p class="edu-empty">Chưa có lớp khai giảng.</p> }
</section>
