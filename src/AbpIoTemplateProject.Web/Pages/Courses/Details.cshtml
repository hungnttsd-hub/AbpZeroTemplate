@page "/Courses/{slug}"
@model AbpIoTemplateProject.Web.Pages.Courses.DetailsModel
@{ Layout = "/Pages/Shared/_IzoneLayout.cshtml"; ViewData["Title"] = Model.Course!.Name; }
<section class="iz-section"><div class="iz-container"><div class="iz-course-detail"><div><p class="iz-eyebrow">@Model.Course!.EntryLevel → @Model.Course.TargetLevel</p><h1>@Model.Course.Name</h1><p class="iz-lead">@Model.Course.ShortDescription</p><div class="iz-course-facts"><span>@Model.Course.SessionCount buổi</span><span>@Model.Course.DurationHours giờ học</span><span>@(Model.Course.TuitionFee?.ToString("N0") ?? "Liên hệ") đ</span></div><a class="iz-btn iz-btn-primary" href="/Contact?courseId=@Model.Course.Id">Nhận tư vấn khóa học</a></div><img src="@(Model.Course.CoverImageUrl ?? Url.Content("~/izone-assets/images/khoahoc/1.jpg"))" alt="@Model.Course.Name" /></div></div></section><section class="iz-section iz-section-soft"><div class="iz-container iz-two-col"><article><h2>Khóa học này dành cho ai?</h2><div class="iz-rich-content">@Html.Raw(Model.Course.Description)</div></article><aside class="iz-detail-aside"><h2>Đội ngũ giảng viên</h2>@if (Model.Course.Teachers.Any()) { foreach (var teacher in Model.Course.Teachers) { <a class="iz-mini-person" href="/Teachers/@teacher.Slug"><img src="@(teacher.AvatarUrl ?? Url.Content("~/izone-assets/images/teachers/1.jpg"))" alt="@teacher.FullName" /><span><b>@teacher.FullName</b><small>@teacher.Title</small></span></a> } } else { <p>Thông tin giảng viên sẽ được cập nhật khi mở lớp.</p> }</aside></div></section>@if (Model.Course.Modules.Any()) { <section class="iz-section"><div class="iz-container"><div class="iz-heading"><p class="iz-eyebrow">NỘI DUNG ĐÀO TẠO</p><h2>Những chặng học chính</h2></div><div class="iz-accordion">@foreach (var module in Model.Course.Modules) { <details><summary>@module.DisplayOrder.ToString("00"). @module.Name</summary><p>@module.Description</p></details>}</div></div></section> }
