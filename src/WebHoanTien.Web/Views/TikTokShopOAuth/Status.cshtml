@model WebHoanTien.Web.Controllers.TikTokShopOAuthStatusModel
@{
    Layout = null;
}
<!doctype html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <title>@Model.Title</title>
    <link rel="stylesheet" href="~/tiktok-shop-oauth.css" asp-append-version="true" />
</head>
<body>
    <main>
        <a class="brand" href="/">CatBack</a>
        <p class="eyebrow">TikTok Shop</p>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
        @if (Model.IsCallbackResult)
        {
            <p class="notice" role="status">Chưa có kết nối được xác nhận. Không cần gửi mã ủy quyền hoặc mật khẩu cho bộ phận hỗ trợ.</p>
        }
        <nav class="actions" aria-label="Điều hướng"><a class="button" href="/">Về trang chủ</a><a href="/Contact">Liên hệ hỗ trợ</a></nav>
        <footer><a href="/About">Giới thiệu CatBack</a><a href="/Legal/Privacy">Privacy Policy</a><a href="/Legal/Terms">Terms of Service</a></footer>
    </main>
</body>
</html>
