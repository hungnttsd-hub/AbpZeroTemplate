@page "/Wallet"
@using WebHoanTien.Web.Pages.Wallet
@model WebHoanTien.Web.Pages.Wallet.IndexModel
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Ví tiền CatBack";
    ViewData["BodyClass"] = "catback-wallet-page";
}

<section class="wallet-shell wallet-overview-shell">
    <header class="wallet-topbar">
        <a href="/" aria-label="Về trang chủ"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 5-7 7 7 7" /></svg></a>
        <h1>Ví tiền</h1>
        <span></span>
    </header>

    <section class="wallet-balance-hero">
        <div>
            <span>Số dư trong ví</span>
            <strong data-wallet-available>@WalletPageUi.FormatMoney(Model.Overview.AvailableBalance)</strong>
            <p><svg viewBox="0 0 24 24"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z"/><path d="m9 12 2 2 4-4"/></svg> Sẵn sàng để rút</p>
        </div>
        <partial name="_WalletIllustration" />
    </section>

    <div class="wallet-metrics">
        <article>
            <span class="wallet-metric-icon confirmed"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="6" width="18" height="13" rx="3"/><path d="M15 10h6v5h-6a2.5 2.5 0 0 1 0-5Z"/><circle cx="16" cy="12.5" r=".7"/></svg></span>
            <div><small>Tổng tiền đã ghi nhận</small><strong>@WalletPageUi.FormatMoney(Model.Overview.TotalRecordedAmount)</strong></div>
        </article>
        <article>
            <span class="wallet-metric-icon pending"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 7v5l3 2"/></svg></span>
            <div><small>Hoa hồng sắp ghi nhận</small><strong>@WalletPageUi.FormatMoney(Model.Overview.PendingCommissionAmount)</strong></div>
        </article>
    </div>

    <div class="wallet-info-banner"><span>i</span><p>Hoa hồng sắp ghi nhận sẽ được cộng vào ví sau khi đơn hàng được Shopee đối soát thành công.</p></div>

    @if (Model.Overview.PendingWithdrawal is not null)
    {
        <div class="wallet-pending-banner" data-pending-withdrawal>
            <div><strong>Đang xử lý yêu cầu @Model.Overview.PendingWithdrawal.RequestCode</strong><span>@WalletPageUi.FormatMoney(Model.Overview.PendingWithdrawal.Amount) · Gửi lúc @WalletPageUi.FormatDate(Model.Overview.PendingWithdrawal.CreationTime)</span></div>
            <form method="post" action="/Wallet?handler=Cancel" data-wallet-cancel>
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.Overview.PendingWithdrawal.Id" />
                <button type="submit">Hủy yêu cầu</button>
            </form>
        </div>
    }

    <div class="wallet-primary-actions">
        <a class="wallet-action-withdraw" href="/Wallet/Withdraw"><svg viewBox="0 0 24 24"><path d="M12 20V5m0 0-5 5m5-5 5 5"/></svg><span>Rút tiền</span><b>›</b></a>
        <a class="wallet-action-history" href="/Wallet/History"><svg viewBox="0 0 24 24"><path d="M6 3h9l4 4v14H6z"/><path d="M14 3v5h5M9 13h7M9 17h5"/></svg><span>Lịch sử ví</span><b>›</b></a>
    </div>

    <section class="wallet-list-card">
        <header><h2>Biến động gần đây</h2><a href="/Wallet/History">Xem tất cả ›</a></header>
        <partial name="_MovementList" model="Model.Overview.RecentMovements" />
    </section>
</section>

<div class="wallet-toast" data-wallet-toast role="status" hidden></div>

@section Scripts {
    <script src="~/wallet.js" asp-append-version="true"></script>
}
