@page
@model OrdersModel
@{
    ViewData["Title"] = "Đơn hàng";
    ViewData["BodyClass"] = "orders-mobile-shell";
}
<section class="cb-orders-page">
    <header class="cb-orders-hero">
        <div class="cb-page-header cb-orders-titlebar cb-mobile-page-header">
            <partial name="/Pages/Shared/_CustomerHeader.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerHeaderModel
            {
                Title = "Đơn hàng",
                BackUrl = "/",
                BackLabel = "Quay về trang chủ"
            })" />
        </div>
        <partial name="/Pages/Shared/_CustomerPageHero.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerPageHeroModel { Title = "Đơn hàng", Description = "Quản lý đơn hàng và theo dõi hoàn tiền của bạn", Note = Model.IsAdminOrderView ? "Phạm vi quản trị: đơn hàng của tất cả khách hàng." : null })" />

        <div class="cb-order-metrics" aria-label="Tổng quan đơn hàng">
            <partial name="/Pages/Shared/_CustomerKpiCard.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerKpiCardModel { Value = Model.PendingCount.ToString(), Label = "Chờ xử lý", Icon = "/orders-icons/clock.svg", IconClass = "cb-metric-pending", ActionUrl = "/Orders?status=pending", ActionLabel = "Xem đơn hàng chờ xử lý" })" />
            <partial name="/Pages/Shared/_CustomerKpiCard.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerKpiCardModel { Value = Model.ConfirmedCount.ToString(), Label = "Đã xác nhận", Icon = "/orders-icons/badge-check.svg", IconClass = "cb-metric-confirmed", ActionUrl = "/Orders?status=confirmed", ActionLabel = "Xem đơn hàng đã xác nhận" })" />
            <partial name="/Pages/Shared/_CustomerKpiCard.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerKpiCardModel { Value = CustomerOrderUi.FormatMoney(Model.ExpectedCashback), Label = "Hoàn tiền dự kiến", Icon = "/orders-icons/cashback.svg", IconClass = "cb-metric-cashback", ActionUrl = "/Wallet", ActionLabel = "Xem ví hoàn tiền" })" />
        </div>
    </header>

    <div class="cb-orders-content">
        <nav class="cb-order-filters cb-list-filters" aria-label="Lọc đơn hàng">
            <a class="@Model.FilterClass(null)" href="/Orders"><i class="cb-desktop-only fa-solid fa-folder-open" hidden aria-hidden="true"></i>Tất cả</a>
            <a class="@Model.FilterClass("pending")" href="/Orders?status=pending"><i class="cb-desktop-only fa-regular fa-clock" hidden aria-hidden="true"></i>Chờ xử lý</a>
            <a class="@Model.FilterClass("confirmed")" href="/Orders?status=confirmed"><i class="cb-desktop-only fa-regular fa-circle-check" hidden aria-hidden="true"></i>Đã xác nhận</a>
            <a class="@Model.FilterClass("cancelled")" href="/Orders?status=cancelled"><i class="cb-desktop-only fa-solid fa-ban" hidden aria-hidden="true"></i>Đã hủy</a>
        </nav>

        @if (Model.Orders.Items.Count == 0)
        {
            <div class="cb-orders-empty">
                <span><img src="~/orders-icons/store.svg" alt="" /></span>
                <h2>Chưa có đơn hàng</h2>
                <p>Đơn sẽ xuất hiện sau khi Shopee ghi nhận và hoàn tất đối soát.</p>
                <a href="/">Tạo link mua hàng</a>
            </div>
        }
        else
        {
            <div class="cb-order-list" id="order-list">
                <partial name="/Pages/Shared/_OrderCards.cshtml" model="Model" />
            </div>
            <div class="catback-infinite-loader@(Model.HasMore ? "" : " is-complete")" data-infinite-scroll
                 data-list-selector="#order-list"
                 data-item-selector=".cb-order-card"
                 data-url="@Model.MoreUrl"
                 data-next-skip="@Model.Orders.Items.Count"
                 data-page-size="@OrdersModel.PageSize"
                 data-total-count="@Model.Orders.TotalCount"
                 data-item-name="đơn hàng"
                 data-loading-message="Đang tải thêm đơn hàng..."
                 data-has-more="@Model.HasMore.ToString().ToLowerInvariant()"
                 role="status"
                 aria-live="polite">
                <span class="catback-chat-loader" aria-hidden="true">
                    <span></span><span></span><span></span>
                </span>
                <span data-loader-message>@(Model.HasMore ? "Kéo xuống để tải thêm đơn hàng..." : $"Đã hiển thị tất cả {Model.Orders.TotalCount} đơn hàng.")</span>
                <button type="button" data-loader-retry hidden>Tải lại</button>
            </div>
        }

        <a class="cb-support-cta" href="mailto:support@webhoantien.com">
            <span><img src="~/orders-icons/headphones.svg" alt="" /></span>
            <span><strong>Cần hỗ trợ?</strong><small>CatBack luôn sẵn sàng giải đáp về đơn hàng.</small></span>
            <img src="~/orders-icons/chevron-right-white.svg" alt="" />
        </a>
    </div>
</section>

@section Scripts {
    <script src="~/orders.js" asp-append-version="true"></script>
    <script src="~/infinite-scroll.js" asp-append-version="true"></script>
}
