@page
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Kiểm tra email — webHoanTien.com";
}

<section class="page-shell narrow-shell">
    <div class="panel center">
        <div class="success-mark">✉</div>
        <h1>Kiểm tra hộp thư của bạn</h1>
        <p>Chúng tôi đã gửi liên kết xác minh. Sau khi xác minh, bạn sẽ tiếp tục hành động đang chờ.</p>
        <p class="muted">Nếu chưa thấy email, hãy kiểm tra thư rác và bảo đảm địa chỉ đã nhập là chính xác.</p>
        <a class="button button-ghost" href="/Account/Login">Về trang đăng nhập</a>
    </div>
</section>
