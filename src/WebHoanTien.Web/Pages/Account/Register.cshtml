@page
@model WebHoanTien.Web.Pages.Account.RegisterModel
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Đăng ký — webHoanTien.com";
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Bắt đầu trong một phút</span>
        <h1>Tạo tài khoản</h1>
        <p class="auth-intro">Dùng email để lưu link và xem các đơn Shopee được ghi nhận.</p>
        @if (!string.IsNullOrWhiteSpace(Model.RegistrationError))
        {
            <div class="status-message status-error">@Model.RegistrationError</div>
        }
        <p class="auth-switch">Đã có tài khoản? <a href="@Url.Page("./Login", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })">Đăng nhập</a></p>

        <form method="post" class="form-stack">
            <input asp-for="Input.UserName" type="hidden" />
            @if (Model.EnableLocalRegister || Model.IsExternalLogin)
            {
                <div class="field">
                    <label asp-for="Input.EmailAddress">Email</label>
                    <input asp-for="Input.EmailAddress" type="email" autocomplete="email" placeholder="ban@example.com" autofocus readonly="@(Model.IsExternalLogin ? "readonly" : null)" />
                    <span asp-validation-for="Input.EmailAddress" class="field-error"></span>
                </div>
            }
            @if (!Model.IsExternalLogin && Model.EnableLocalRegister)
            {
                <div class="field">
                    <label asp-for="Input.Password">Mật khẩu</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
                <div class="field">
                    <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
                    <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>
            }
            @if (Model.EnableLocalRegister || Model.IsExternalLogin)
            {
                <label class="check-row check-legal">
                    <input asp-for="AcceptedTerms" />
                    <span>Tôi đồng ý với <a href="/Legal/Terms" target="_blank">Điều khoản</a> và <a href="/Legal/Privacy" target="_blank">Chính sách riêng tư</a>.</span>
                </label>
                <span asp-validation-for="AcceptedTerms" class="field-error"></span>
                <button type="submit" class="button button-primary button-wide">Tạo tài khoản</button>
            }
        </form>

        @if (!Model.IsExternalLogin && Model.VisibleExternalProviders.Any())
        {
            <div class="auth-divider"><span>hoặc</span></div>
            <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" asp-route-returnUrlHash="@Model.ReturnUrlHash" method="post" class="external-logins">
                @foreach (var provider in Model.VisibleExternalProviders)
                {
                    <button type="submit" class="button button-ghost button-wide" name="provider" value="@provider.AuthenticationScheme">
                        Đăng ký với @provider.DisplayName
                    </button>
                }
            </form>
        }
    </div>
    <aside class="auth-aside">
        <span class="eyebrow">Minh bạch ngay từ đầu</span>
        <h2>Bạn nhận 70% hoa hồng thực nhận.</h2>
        <p>Tỷ lệ được chụp lại tại thời điểm đặt hàng. Đơn hủy, hoàn hoặc bị từ chối không phát sinh cashback phải trả.</p>
    </aside>
</section>
