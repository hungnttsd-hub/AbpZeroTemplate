@page
@model WebHoanTien.Web.Pages.Account.RegisterModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Đăng ký — CatBack";
    var googleClientId = Configuration["Authentication:Google:ClientId"];
    var hasGoogleProvider = Model.VisibleExternalProviders.Any(provider => provider.AuthenticationScheme == "Google");
    var otherProviders = Model.VisibleExternalProviders.Where(provider => provider.AuthenticationScheme != "Google").ToList();
}

<section class="auth-shell">
    <div class="auth-card">
        <span class="eyebrow">Bắt đầu trong một phút</span>
        <h1>Tạo tài khoản</h1>
        <p class="auth-intro">Dùng email để lưu link và xem các đơn Shopee được ghi nhận.</p>
        @if (!string.IsNullOrWhiteSpace(Model.RegistrationError))
        {
            <div class="status-message status-error">@Model.RegistrationError</div>
        }
        <p class="auth-switch">Đã có tài khoản? <a href="@Url.Page("./Login", new { returnUrl = Model.ReturnUrl, returnUrlHash = Model.ReturnUrlHash })">Đăng nhập</a></p>

        <form method="post" class="form-stack">
            <input asp-for="Input.UserName" type="hidden" />
            @if (Model.EnableLocalRegister || Model.IsExternalLogin)
            {
                <div class="field">
                    <label asp-for="Input.EmailAddress">Email</label>
                    <input asp-for="Input.EmailAddress" type="email" autocomplete="email" placeholder="ban@example.com" autofocus readonly="@(Model.IsExternalLogin ? "readonly" : null)" />
                    <span asp-validation-for="Input.EmailAddress" class="field-error"></span>
                </div>
            }
            @if (!Model.IsExternalLogin && Model.EnableLocalRegister)
            {
                <div class="field">
                    <label asp-for="Input.Password">Mật khẩu (ít nhất 6 ký tự)</label>
                    <input asp-for="Input.Password" type="password" autocomplete="new-password" />
                    <span asp-validation-for="Input.Password" class="field-error"></span>
                </div>
            }
            @if (Model.EnableLocalRegister || Model.IsExternalLogin)
            {
                <label class="check-row check-legal">
                    <input asp-for="AcceptedTerms" />
                    <span>Tôi đồng ý với <a href="/Legal/Terms" target="_blank">Điều khoản</a> và <a href="/Legal/Privacy" target="_blank">Chính sách riêng tư</a>.</span>
                </label>
                <span asp-validation-for="AcceptedTerms" class="field-error"></span>
                <button type="submit" class="button button-primary button-wide">@(Model.IsExternalLogin ? "Hoàn tất đăng ký bằng Google" : "Tạo tài khoản")</button>
            }
        </form>

        @if (!Model.IsExternalLogin && ((hasGoogleProvider && !string.IsNullOrWhiteSpace(googleClientId)) || otherProviders.Any()))
        {
            <div class="auth-divider"><span>hoặc</span></div>
            @if (hasGoogleProvider && !string.IsNullOrWhiteSpace(googleClientId))
            {
                <div class="google-identity-login"
                     data-google-identity
                     data-client-id="@googleClientId"
                     data-return-url="@Model.ReturnUrl">
                    <form action="/account/google/identity/login" method="post" data-google-identity-form>
                        @Html.AntiForgeryToken()
                    </form>
                    <button type="button" class="google-oauth-button" data-google-identity-button>
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="#4285f4" d="M21.8 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.5a4.7 4.7 0 0 1-2 3.1v2.5h3.2c1.9-1.8 3.1-4.3 3.1-7.4Z" />
                            <path fill="#34a853" d="M12 22c2.7 0 5-.9 6.7-2.4l-3.2-2.5c-.9.6-2 .9-3.5.9-2.7 0-5-1.8-5.8-4.3H2.9v2.6A10 10 0 0 0 12 22Z" />
                            <path fill="#fbbc05" d="M6.2 13.7a6 6 0 0 1 0-3.7V7.4H2.9a10 10 0 0 0 0 9l3.3-2.7Z" />
                            <path fill="#ea4335" d="M12 6c1.6 0 3 .6 4.1 1.6l3-3A10 10 0 0 0 2.9 7.4l3.3 2.6C7 7.8 9.3 6 12 6Z" />
                        </svg>
                        <span>Tiếp tục với Google</span>
                    </button>
                    <p class="google-identity-status" data-google-identity-status role="status" hidden></p>
                    <p class="google-identity-legal">Không cần tích ô phía trên. Bằng việc tiếp tục với Google, bạn đồng ý với <a href="/Legal/Terms" target="_blank">Điều khoản</a> và <a href="/Legal/Privacy" target="_blank">Chính sách riêng tư</a>.</p>
                </div>
            }
            @if (otherProviders.Any())
            {
                <form asp-page="./Login" asp-page-handler="ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" asp-route-returnUrlHash="@Model.ReturnUrlHash" method="post" class="external-logins">
                    @foreach (var provider in otherProviders)
                    {
                        <button type="submit" class="button button-wide external-login-button button-ghost" name="provider" value="@provider.AuthenticationScheme">
                            <span>Tiếp tục với @provider.DisplayName</span>
                        </button>
                    }
                </form>
            }
        }
    </div>
    <aside class="auth-aside">
        <span class="eyebrow">Minh bạch ngay từ đầu</span>
        <h2>Đơn đầu hoàn 100%, đơn tiếp theo hoàn 80% hoa hồng.</h2>
        <p>Tỷ lệ được chụp lại tại thời điểm đặt hàng. Đơn hủy, hoàn hoặc bị từ chối không phát sinh cashback phải trả.</p>
    </aside>
</section>

@section Scripts {
    <script src="~/google-identity.js" asp-append-version="true" defer></script>
}
