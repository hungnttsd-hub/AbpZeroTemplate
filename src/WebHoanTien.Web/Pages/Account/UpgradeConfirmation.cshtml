@page
@model WebHoanTien.Web.Pages.Account.AccountFlowModel
@{ Layout = "/Pages/Shared/_CustomerLayout.cshtml"; ViewData["Title"] = "Xác minh nâng cấp"; }
<section class="cb-account-shell"><div class="cb-card cb-account-card"><h1>Xác minh nâng cấp tài khoản</h1>
    @if (!string.IsNullOrEmpty(Model.Error)) { <p role="alert" class="cb-account-warning">@Model.Error</p><a href="/Account/Upgrade">Quay lại nâng cấp</a> }
    else { <p>Xác nhận email để hoàn tất nâng cấp. Số dư, link và đơn hàng được giữ nguyên.</p><form method="post" asp-page-handler="Confirm" data-turbo="false"><input type="hidden" asp-for="Token" /><button class="button cb-account-primary">Xác minh email và hoàn tất</button></form> }
</div></section>
