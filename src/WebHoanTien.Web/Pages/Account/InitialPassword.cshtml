@page
@model WebHoanTien.Web.Pages.Account.InitialPasswordModel
@{ ViewData["Title"] = "Đổi mật khẩu quản trị"; }
<section class="page-shell narrow-shell">
    <div class="page-heading"><div><span class="eyebrow">Bảo mật bắt buộc</span><h1>Đổi mật khẩu quản trị</h1></div></div>
    <p>Mật khẩu ban đầu chỉ dùng để bàn giao. Hãy đổi mật khẩu trước khi sử dụng chức năng quản trị.</p>
    @if (!string.IsNullOrWhiteSpace(Model.Error)) { <div class="status-message status-error">@Model.Error</div> }
    <form method="post" class="form-stack">
        <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
        <input asp-for="CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="CurrentPassword"></span>
        <label asp-for="NewPassword">Mật khẩu mới</label>
        <input asp-for="NewPassword" autocomplete="new-password" />
        <span asp-validation-for="NewPassword"></span>
        <label asp-for="ConfirmPassword">Nhập lại mật khẩu mới</label>
        <input asp-for="ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="ConfirmPassword"></span>
        <button class="button button-primary" type="submit">Đổi mật khẩu và tiếp tục</button>
    </form>
</section>
