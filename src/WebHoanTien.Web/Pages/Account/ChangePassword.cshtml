@page
@model WebHoanTien.Web.Pages.Account.ChangePasswordModel
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    var actionLabel = Model.HasPassword ? "Đổi mật khẩu" : "Đặt mật khẩu";
    ViewData["Title"] = actionLabel + " — CatBack";
}

<section class="profile-shell">
    <header class="cb-page-header profile-heading">
        <div>
            <span class="eyebrow">Bảo mật tài khoản</span>
            <h1>@actionLabel</h1>
            <p>Quản lý mật khẩu đăng nhập trực tiếp trên CatBack.</p>
        </div>
    </header>

    <div class="profile-grid">
        <div class="profile-main">
            <article class="cb-card profile-card">
                <h2>Mật khẩu đăng nhập</h2>
                <p>@(Model.HasPassword
                    ? "Nhập mật khẩu hiện tại, sau đó đặt mật khẩu mới cho tài khoản của bạn."
                    : "Tài khoản Google của bạn chưa có mật khẩu CatBack. Đặt mật khẩu để đăng nhập bằng username/email hoặc tiếp tục với Google.")</p>

                <form method="post" class="payout-form">
                    <div asp-validation-summary="ModelOnly" class="profile-form-error"></div>

                    @if (Model.HasPassword)
                    {
                        <div class="profile-field">
                            <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                            <input asp-for="CurrentPassword" type="password" autocomplete="current-password" autofocus />
                            <span asp-validation-for="CurrentPassword" class="profile-form-error"></span>
                        </div>
                    }

                    <div class="profile-field">
                        <label asp-for="NewPassword">Mật khẩu mới</label>
                        <input asp-for="NewPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="NewPassword" class="profile-form-error"></span>
                    </div>

                    <div class="profile-field">
                        <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                        <input asp-for="ConfirmPassword" type="password" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmPassword" class="profile-form-error"></span>
                    </div>

                    <button class="button payout-save-button" type="submit">@actionLabel</button>
                </form>
            </article>
        </div>

        <aside class="profile-side">
            <article class="cb-card profile-card profile-highlight-card">
                <span class="profile-card-icon" aria-hidden="true">✓</span>
                <h2>Lưu ý bảo mật</h2>
                <p>Mật khẩu mới phải có từ 6 đến 128 ký tự và đáp ứng yêu cầu bảo mật của CatBack.</p>
                <p>Nếu tài khoản đã liên kết Google, sau khi đặt hoặc đổi mật khẩu bạn vẫn có thể đăng nhập bằng Google.</p>
                <a class="button button-ghost" href="/Account/Profile">Quay lại tài khoản</a>
            </article>
        </aside>
    </div>
</section>
