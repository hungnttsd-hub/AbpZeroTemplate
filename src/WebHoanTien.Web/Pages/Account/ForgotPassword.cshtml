@page
@model WebHoanTien.Web.Pages.Account.ForgotPasswordModel
@{
    Layout = "/Pages/Shared/_CustomerLayout.cshtml";
    ViewData["Title"] = "Quên mật khẩu — CatBack";
}

<section class="auth-shell">
    <div class="auth-card">
        <img class="auth-card-logo" src="~/catback-logo.png" alt="CatBack" />
        <span class="auth-badge">Khôi phục tài khoản</span>
        <h1>Quên mật khẩu</h1>
        <p>Nhập email đăng nhập hoặc email liên hệ đã lưu trên tài khoản CatBack. Mật khẩu mới sẽ được gửi về đúng email bạn nhập.</p>

        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="status-message status-info" role="status">@Model.StatusMessage</div>
        }

        <form method="post" class="form-stack">
            <div asp-validation-summary="ModelOnly" class="status-message status-error"></div>

            <div class="field">
                <label asp-for="Email">Email nhận mật khẩu</label>
                <input asp-for="Email" type="email" autocomplete="email" autofocus />
                <span asp-validation-for="Email"></span>
            </div>

            <button class="button" type="submit">Gửi mật khẩu mới</button>
        </form>

        <div class="auth-links">
            <a href="./Login">Quay lại đăng nhập</a>
        </div>
    </div>
</section>
