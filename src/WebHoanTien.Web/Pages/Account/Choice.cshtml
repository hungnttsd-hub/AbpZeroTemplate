@page
@model WebHoanTien.Web.Pages.Account.AccountFlowModel
@{ Layout = "/Pages/Shared/_CustomerLayout.cshtml"; ViewData["Title"] = "Chọn cách tiếp tục"; }
<section class="cb-account-shell"><a class="cb-account-back" href="@Model.SafeReturnUrl">‹ Quay lại</a><div class="cb-account-card">
    <span class="eyebrow">Chào mừng bạn đến với CatBack</span><h1>Chọn cách tiếp tục</h1><p class="cb-account-lead">Bạn có thể chọn một trong ba cách dưới đây để tiếp tục.</p>
    <partial name="/Pages/Shared/_AccountGoogle.cshtml" model="Model.SafeReturnUrl" />
    <a class="cb-account-option" href="@Model.WithReturn("/Account/Login")"><span class="cb-account-icon"><i class="fa-regular fa-user" aria-hidden="true"></i></span><span><strong>Đăng nhập bằng tài khoản</strong><small>Dùng username hoặc email và mật khẩu để đăng nhập.</small></span><span aria-hidden="true">›</span></a>
    <a class="cb-account-option" href="@Model.WithReturn("/Account/Anonymous")"><span class="cb-account-icon cb-account-icon-gold"><i class="fa-solid fa-user-secret" aria-hidden="true"></i></span><span><strong>Sử dụng tài khoản ẩn danh</strong><small>Không cần đăng ký ngay, có mã khôi phục.</small></span><span aria-hidden="true">›</span></a>
    <p class="cb-account-note">Tài khoản ẩn danh có <a href="@Model.WithReturn("/Account/Recovery")">mã khôi phục</a> để dùng lại sau này.</p>
    <div class="cb-account-info"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><span><strong>Bảo vệ tài khoản của bạn</strong><br />Giữ kín mã khôi phục và đăng ký tài khoản khi cần rút tiền.</span></div>
</div></section>
@section Scripts { <script src="~/google-identity.js" asp-append-version="true" defer></script> }
