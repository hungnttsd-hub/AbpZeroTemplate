@page
@model IndexModel
@{
    ViewData["Title"] = "CatBack — Mua sắm Shopee thông minh";
    ViewData["BodyClass"] = "catback-link-page";
}
<section class="customer-dashboard">
    <section class="dashboard-hero" aria-labelledby="dashboard-hero-title">
        <div class="dashboard-hero-copy">
            <img class="dashboard-hero-mascot" src="~/catback-mascot-reference.png" alt="Mèo may mắn CatBack" />
            <div>
                <h1 id="dashboard-hero-title">Sắm Shopee lời hơn<br />cùng CatBack</h1>
                <span class="dashboard-trust-badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
                    Hoàn tiền thật – Rút tiền thật
                </span>
            </div>
        </div>
        <div class="dashboard-cashback-note">
            <p>
                <span class="dashboard-cashback-heading">⚡ Hoàn tiền lên tới
                    <strong class="dashboard-highlight-rate">80%</strong>
                    <span>hoa hồng</span>
                </span>
                <span class="dashboard-cashback-subtitle">Nhận hoàn tiền sau khi Shopee đối soát đơn hàng.</span>
                <button class="install-app-button dashboard-install-button" id="install-app-button" type="button">Cài đặt ngay</button>
            </p>
        </div>
    </section>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="dashboard-wallet-card" href="/Wallet" aria-label="Xem ví tiền CatBack">
            <div>
                <span>Số dư ví</span>
                <strong>@Model.Wallet.AvailableBalance.ToString("N0")đ</strong>
                <dl>
                    <div><dt>Đã ghi nhận</dt><dd>@Model.Wallet.TotalRecordedAmount.ToString("N0")đ</dd></div>
                    <div><dt>Sắp ghi nhận</dt><dd>@Model.Wallet.PendingCommissionAmount.ToString("N0")đ</dd></div>
                </dl>
            </div>
            <span class="dashboard-wallet-visual">
                <partial name="/Pages/Wallet/_WalletIllustration.cshtml" />
                <b>Xem ví</b>
            </span>
        </a>
    }

    <div class="dashboard-grid">
        <div class="dashboard-main">
            <form method="post" asp-page-handler="Prepare" class="dashboard-create-card" id="link-form" data-ajax-create data-turbo="false">
                <div class="dashboard-create-heading">
                    <span class="dashboard-create-icon" aria-hidden="true"><img src="~/catback/icons/link.svg" alt="" /></span>
                    <div><h2>Dán link Shopee tại đây <span aria-hidden="true">✦</span></h2></div>
                </div>
                <p class="affiliate-auto-detect-note">
                    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="8"/><path d="M10 9v5M10 6.2h.01"/></svg>
                    Nhận cả link sản phẩm và link cửa hàng — CatBack tự động nhận diện.
                </p>
                <a class="dashboard-guide-link" href="/huong-dan#tao-link-hoan-tien">Xem hướng dẫn <span aria-hidden="true">›</span></a>
                <label class="sr-only" id="affiliate-url-label" for="affiliate-url">Link sản phẩm hoặc cửa hàng Shopee</label>
                <div class="dashboard-input-shell">
                    <span aria-hidden="true"><img src="~/catback/icons/link-dark.svg" alt="" /></span>
                    <input asp-for="LinkUrl" id="affiliate-url" type="url" inputmode="url" autocomplete="url"
                           placeholder="Dán link sản phẩm hoặc cửa hàng Shopee..."
                           aria-labelledby="affiliate-url-label" required maxlength="2048" />
                    <button class="dashboard-input-clear" id="affiliate-url-clear" type="button" aria-label="Xóa link đang nhập" hidden>×</button>
                </div>
                <div id="url-status" class="url-status" data-state="@(Model.Error is not null ? "error" : Model.SuccessMessage is not null ? "success" : "idle")" role="status" aria-live="polite">@(Model.Error ?? Model.SuccessMessage ?? string.Empty)</div>
                @if (Model.CreatedLink?.TargetType is AffiliateLinkTargetType.Product or AffiliateLinkTargetType.Shop)
                {
                    var createdIsShop = Model.CreatedLink.TargetType == AffiliateLinkTargetType.Shop;
                    var createdFallbackTitle = createdIsShop && !string.IsNullOrWhiteSpace(Model.CreatedLink.ShopId)
                        ? $"Shop #{Model.CreatedLink.ShopId}"
                        : createdIsShop ? "Cửa hàng Shopee" : "Sản phẩm Shopee";
                    var createdTitle = !string.IsNullOrWhiteSpace(Model.CreatedLink.ProductName)
                        ? Model.CreatedLink.ProductName
                        : createdFallbackTitle;
                    var createdFallbackImage = createdIsShop
                        ? "/catback/icons/shop-placeholder.svg"
                        : "/catback/icons/shopping-bag.svg";
                    var createdImage = !string.IsNullOrWhiteSpace(Model.CreatedLink.ImageUrl)
                        ? Model.CreatedLink.ImageUrl
                        : createdFallbackImage;
                    <div class="affiliate-inline-result @(createdIsShop ? "is-shop" : "is-product")" data-affiliate-inline-result>
                        <div class="affiliate-inline-result-summary">
                            <img class="affiliate-inline-result-image" src="@createdImage" alt="Ảnh @createdTitle"
                                 onerror="this.onerror=null;this.src='@createdFallbackImage'" />
                            <div class="affiliate-inline-result-copy">
                                <strong>@createdTitle</strong>
                                @if (createdIsShop)
                                {
                                    <span class="affiliate-target-badge">Link cửa hàng</span>
                                    <small data-affiliate-stable-url>@($"{Request.Host}{Request.PathBase}{Model.CreatedLink.RedirectUrl}")</small>
                                }
                                else if (Model.CreatedLink.EstimatedCommission.HasValue)
                                {
                                    <span class="affiliate-inline-estimate">Hoàn lại dự kiến @Model.CreatedLink.EstimatedCommission.Value.ToString("N0")₫</span>
                                }
                                else
                                {
                                    <span class="affiliate-inline-estimate unavailable">Chưa có ước tính hoa hồng</span>
                                }
                            </div>
                            <button class="affiliate-inline-copy" type="button" data-copy-url="@Model.CreatedLink.RedirectUrl" aria-label="Sao chép link">
                                <img src="~/catback/icons/copy-link.svg" alt="" />
                                <span data-copy-label>Sao chép</span>
                            </button>
                        </div>
                        <a class="affiliate-inline-buy-button" href="@Model.CreatedLink.RedirectUrl" target="_blank"
                           data-iphone-external-url="@Model.CreatedLink.DirectUrl"
                           data-iphone-track-url="@(Model.CreatedLink.RedirectUrl + "/click")"
                           data-turbo="false" rel="nofollow sponsored noopener">@(createdIsShop ? "Vào Shop mua hàng" : "Mua ngay") <span>→</span></a>
                        <p class="affiliate-inline-result-hint"><img src="~/catback/icons/shield-check.svg" alt="" />@(createdIsShop ? "Mở shop trên Shopee để thêm nhiều sản phẩm vào giỏ hàng trong cùng một lần mua." : "Mở sản phẩm trên Shopee và hoàn tất đơn trong cùng phiên để được ghi nhận hoàn tiền.")</p>
                    </div>
                }
                <button class="dashboard-create-button" type="submit" id="create-button" hidden="@(Model.CreatedLink?.TargetType is AffiliateLinkTargetType.Product or AffiliateLinkTargetType.Shop ? "hidden" : null)">Tạo link hoàn tiền <span>→</span></button>
                <template id="affiliate-inline-result-template">
                    <div class="affiliate-inline-result" data-affiliate-inline-result>
                        <div class="affiliate-inline-result-summary">
                            <img class="affiliate-inline-result-image" data-affiliate-image src="/catback/icons/shopping-bag.svg" alt="" />
                            <div class="affiliate-inline-result-copy">
                                <strong data-affiliate-title>Sản phẩm Shopee</strong>
                                <span class="affiliate-target-badge" data-affiliate-target-badge hidden>Link cửa hàng</span>
                                <small data-affiliate-stable-url hidden></small>
                                <span class="affiliate-inline-estimate" data-affiliate-estimate>Chưa có ước tính hoa hồng</span>
                            </div>
                            <button class="affiliate-inline-copy" type="button" data-copy-url="" aria-label="Sao chép link">
                                <img src="/catback/icons/copy-link.svg" alt="" />
                                <span data-copy-label>Sao chép</span>
                            </button>
                        </div>
                        <a class="affiliate-inline-buy-button" href="#" target="_blank"
                           data-iphone-external-url="" data-iphone-track-url=""
                           data-turbo="false" rel="nofollow sponsored noopener"><span data-affiliate-buy-label>Mua ngay</span> <span>→</span></a>
                        <p class="affiliate-inline-result-hint"><img src="/catback/icons/shield-check.svg" alt="" /><span data-affiliate-hint>Mở sản phẩm trên Shopee và hoàn tất đơn trong cùng phiên để được ghi nhận hoàn tiền.</span></p>
                    </div>
                </template>
            </form>

            <section class="dashboard-links" aria-labelledby="your-links-heading" data-created-list-limit="5">
                <header class="dashboard-section-heading">
                    <h2 id="your-links-heading">Link của bạn</h2>
                </header>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="dashboard-empty"><h3>Đăng nhập để lưu link</h3><p>Link mua hàng sẽ xuất hiện tại đây sau khi bạn đăng nhập.</p><a class="dashboard-text-link" href="/Account/Login">Đăng nhập</a></div>
                }
                else if (Model.RecentLinks.Items.Count == 0)
                {
                    <div class="dashboard-empty dashboard-link-empty">
                        <img src="~/catback/icons/empty-box.svg" alt="" />
                        <h3>Bạn chưa có link nào</h3>
                        <p>Dán link Shopee để nhận hoàn tiền ngay!</p>
                        <div class="dashboard-link-empty-actions">
                            <button type="button" data-focus-link-input>Dán link ngay</button>
                            <a href="/huong-dan#tao-link-hoan-tien">Hướng dẫn tạo link <span>›</span></a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="affiliate-link-list">
                    @foreach (var item in Model.RecentLinks.Items)
                    {
                        var isNew = item.Id == Model.CreatedLinkId;
                        var isShop = item.TargetType == AffiliateLinkTargetType.Shop;
                        var isProduct = item.TargetType == AffiliateLinkTargetType.Product;
                        var shopFallback = !string.IsNullOrWhiteSpace(item.ShopId) ? $"Shop #{item.ShopId}" : "Cửa hàng Shopee";
                        var cardTitle = isShop
                            ? !string.IsNullOrWhiteSpace(item.ProductName) ? item.ProductName : shopFallback
                            : isProduct ? item.ProductName ?? "Sản phẩm Shopee" : "Link Shopee";
                        var buyLabel = isShop ? "Vào Shop" : isProduct ? "Mua ngay" : "Mở Shopee";
                        var fallbackImage = isShop ? "/catback/icons/shop-placeholder.svg" : "/catback/icons/shopping-bag.svg";
                        <article class="affiliate-link-card @(isShop ? "is-shop-link" : !isProduct ? "is-legacy-link" : string.Empty) @(isNew ? "is-new" : string.Empty) @(item.IsHidden ? "is-hidden" : string.Empty)" id="@(isNew ? "latest-link" : string.Empty)" data-link-id="@item.Id" data-target-type="@item.TargetType">
                            <div class="affiliate-product-image">
                                @if ((isProduct || isShop) && !string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Ảnh @cardTitle" loading="lazy"
                                         onerror="this.onerror=null;this.src='@fallbackImage'" />
                                }
                                else
                                {
                                    <span><img src="@(isShop ? "/catback/icons/shop-placeholder.svg" : isProduct ? "/catback/icons/shopping-bag.svg" : "/catback/icons/store.svg")" alt="" /></span>
                                }
                            </div>
                            <div class="affiliate-link-details">
                                <h3>@cardTitle</h3>
                                @if (isProduct)
                                {
                                    <p class="affiliate-store">Sản phẩm từ Shopee</p>
                                }
                                else if (isShop)
                                {
                                    <span class="affiliate-target-badge">Link cửa hàng</span>
                                    <p class="affiliate-link-meta">Mua nhiều sản phẩm trong cùng shop</p>
                                }
                                else
                                {
                                    <p class="affiliate-store">Link Shopee</p>
                                    <p class="affiliate-link-meta">Link cũ chưa phân loại</p>
                                }
                                @if (item.IsHidden)
                                {
                                    <span class="affiliate-hidden-badge">Đã ẩn</span>
                                }
                                @if (isProduct)
                                {
                                    @if (item.EstimatedCommission.HasValue)
                                    {
                                        <p class="affiliate-estimate">Hoàn lại dự kiến @item.EstimatedCommission.Value.ToString("N0")₫</p>
                                    }
                                    else
                                    {
                                        <p class="affiliate-estimate unavailable">Chưa có ước tính hoa hồng</p>
                                    }
                                }
                            </div>
                            <div class="affiliate-link-actions">
                                <a class="affiliate-buy-button" href="@item.RedirectUrl" target="_blank"
                                   data-iphone-external-url="@item.DirectUrl"
                                   data-iphone-track-url="@(item.RedirectUrl + "/click")"
                                   data-turbo="false" rel="nofollow sponsored noopener">@buyLabel</a>
                                <div class="affiliate-link-secondary-actions">
                                    @if (!string.IsNullOrWhiteSpace(item.RedirectUrl))
                                    {
                                        <button class="affiliate-icon-action affiliate-copy-button" type="button" data-copy-url="@item.RedirectUrl" aria-label="Sao chép link" title="Sao chép link">
                                            <img src="~/catback/icons/copy-link.svg" alt="" />
                                            <span class="sr-only" data-copy-label>Sao chép link</span>
                                        </button>
                                    }
                                    <form method="post" asp-page-handler="SetHidden" asp-antiforgery="true" data-turbo="false"
                                          data-link-visibility-form data-link-id="@item.Id">
                                        <input type="hidden" name="linkId" value="@item.Id" />
                                        <input type="hidden" name="visibilityAction" value="@(item.IsHidden ? "show" : "hide")" />
                                        <input type="hidden" name="showHidden" value="@Model.ShowHidden" />
                                        <button class="affiliate-icon-action affiliate-hide-desktop-button" type="submit"
                                                aria-label="@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")"
                                                title="@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")">
                                            <img data-visibility-icon src="@(item.IsHidden ? "/catback/icons/eye-off.svg" : "/catback/icons/trash.svg")" alt="" />
                                            <span class="sr-only" data-visibility-label>@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                }
                @if (User.Identity?.IsAuthenticated == true && Model.RecentLinks.Items.Count > 0)
                {
                    <a class="dashboard-view-all-links" href="/Links">
                        <span>Xem tất cả link đã tạo</span>
                        <span aria-hidden="true">→</span>
                    </a>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <template id="affiliate-link-empty-template">
                        <div class="dashboard-empty dashboard-link-empty">
                            <img src="~/catback/icons/empty-box.svg" alt="" />
                            <h3>Bạn chưa có link nào</h3>
                            <p>Dán link Shopee để nhận hoàn tiền ngay!</p>
                            <div class="dashboard-link-empty-actions">
                                <button type="button" data-focus-link-input>Dán link ngay</button>
                                <a href="/huong-dan#tao-link-hoan-tien">Hướng dẫn tạo link <span>›</span></a>
                            </div>
                        </div>
                    </template>
                    <template id="affiliate-link-card-template">
                        <article class="affiliate-link-card is-new" data-link-id="" data-target-type="Product">
                            <div class="affiliate-product-image">
                                <img data-link-image src="" alt="" loading="lazy" hidden />
                                <span data-link-placeholder><img data-link-placeholder-icon src="~/catback/icons/shopping-bag.svg" alt="" /></span>
                            </div>
                            <div class="affiliate-link-details">
                                <h3 data-link-title>Sản phẩm Shopee</h3>
                                <p class="affiliate-store" data-link-store>Sản phẩm từ Shopee</p>
                                <span class="affiliate-target-badge" data-link-target-badge hidden>Link cửa hàng</span>
                                <p class="affiliate-link-meta" data-link-meta hidden></p>
                                <p class="affiliate-estimate unavailable" data-estimated-commission>Chưa có ước tính hoa hồng</p>
                            </div>
                            <div class="affiliate-link-actions">
                                <a class="affiliate-buy-button" href="#" target="_blank" data-buy-label
                                   data-iphone-external-url="" data-iphone-track-url=""
                                   data-turbo="false" rel="nofollow sponsored noopener">Mua ngay</a>
                                <div class="affiliate-link-secondary-actions">
                                    <button class="affiliate-icon-action affiliate-copy-button" type="button" data-copy-url="" aria-label="Sao chép link" title="Sao chép link">
                                        <img src="~/catback/icons/copy-link.svg" alt="" />
                                        <span class="sr-only" data-copy-label>Sao chép link</span>
                                    </button>
                                    <form method="post" asp-page-handler="SetHidden" asp-antiforgery="true" data-turbo="false"
                                          data-link-visibility-form data-link-id="">
                                        <input type="hidden" name="linkId" value="" />
                                        <input type="hidden" name="visibilityAction" value="hide" />
                                        <input type="hidden" name="showHidden" value="false" />
                                        <button class="affiliate-icon-action affiliate-hide-desktop-button" type="submit" aria-label="Ẩn link khỏi danh sách" title="Ẩn link khỏi danh sách">
                                            <img data-visibility-icon src="~/catback/icons/trash.svg" alt="" />
                                            <span class="sr-only" data-visibility-label>Ẩn link khỏi danh sách</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </template>
                }
            </section>
        </div>

        <aside class="dashboard-sidebar">
            <section class="affiliate-guide" id="how">
                <h2>Để chắc chắn được tính hoa hồng</h2>
                <ol>
                    <li><span>1</span><p>Bấm <strong>Mua ngay</strong> hoặc <strong>Vào Shop mua hàng</strong> để sang Shopee rồi đặt hàng.</p></li>
                    <li><span>2</span><p><strong>Mỗi đơn một lần bấm.</strong> Mua thêm đơn nữa thì quay lại đây bấm Mua ngay lần nữa, không bấm lại thì đơn sau không được tính.</p></li>
                    <li><span>3</span><p>Đặt hàng <strong>trong vòng 7 ngày</strong> kể từ lúc bấm Mua ngay.</p></li>
                    <li><span>4</span><p><strong>Tuyệt đối đừng xem video hay livestream của sản phẩm đó</strong> trên sàn. Xem livestream sẽ kích hoạt hoa hồng cho bên livestream: CatBack không nhận được gì, nên cũng không có gì để chia lại cho bạn.</p></li>
                    <li><span>5</span><p>Sau khi bấm Mua ngay và truy cập sản phẩm trên sàn, <strong>đừng vội mua hàng ngay lập tức</strong>. Hãy kéo xuống đọc thông tin về sản phẩm vài giây rồi hãy chốt đơn nhé.</p></li>
                </ol>
            </section>
        </aside>
    </div>
</section>

@section Scripts {
<script src="~/customer.js" asp-append-version="true"></script>
}
