@page
@model IndexModel
@{
    ViewData["Title"] = "CatBack — Mua sắm Shopee thông minh";
    ViewData["BodyClass"] = "catback-link-page";
}
<section class="customer-dashboard">
    <section class="dashboard-hero" aria-labelledby="dashboard-hero-title">
        <div class="dashboard-hero-copy">
            <img class="dashboard-hero-mascot" src="~/catback-mascot-reference.png" alt="Mèo may mắn CatBack" />
            <div>
                <h1 id="dashboard-hero-title">Sắm Shopee lời hơn<br />cùng CatBack</h1>
                <span class="dashboard-trust-badge">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 5 6v5c0 4.7 2.7 8 7 10 4.3-2 7-5.3 7-10V6l-7-3Z" /><path d="m9 12 2 2 4-4" /></svg>
                    Hoàn tiền thật – Rút tiền thật
                </span>
            </div>
        </div>
        <div class="dashboard-cashback-note">
            <p>
                <span class="dashboard-cashback-heading">⚡ Hoàn tiền lên tới
                    <strong class="dashboard-highlight-rate">80%</strong>
                    <span>hoa hồng</span>
                </span>
                <span class="dashboard-cashback-subtitle">Nhận hoàn tiền sau khi Shopee đối soát đơn hàng.</span>
                <button class="install-app-button dashboard-install-button" id="install-app-button" type="button">Cài đặt ngay</button>
            </p>
        </div>
    </section>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <a class="dashboard-wallet-card" href="/Wallet" aria-label="Xem ví tiền CatBack">
            <div>
                <span>Số dư ví</span>
                <strong>@Model.Wallet.AvailableBalance.ToString("N0")đ</strong>
                <dl>
                    <div><dt>Đã ghi nhận</dt><dd>@Model.Wallet.TotalRecordedAmount.ToString("N0")đ</dd></div>
                    <div><dt>Sắp ghi nhận</dt><dd>@Model.Wallet.PendingCommissionAmount.ToString("N0")đ</dd></div>
                </dl>
            </div>
            <span class="dashboard-wallet-visual">
                <partial name="/Pages/Wallet/_WalletIllustration.cshtml" />
                <b>Xem ví</b>
            </span>
        </a>
    }

    <div class="dashboard-grid">
        <div class="dashboard-main">
            <form method="post" asp-page-handler="Prepare" class="dashboard-create-card" id="link-form" data-ajax-create>
                <div class="dashboard-create-heading">
                    <span class="dashboard-create-icon" aria-hidden="true"><img src="~/catback/icons/link.svg" alt="" /></span>
                    <div><h2>Dán link Shopee tại đây <span aria-hidden="true">✦</span></h2><a class="dashboard-guide-link" href="/huong-dan#tao-link-hoan-tien">Xem hướng dẫn <span aria-hidden="true">›</span></a></div>
                </div>
                <label class="sr-only" for="affiliate-url">Link sản phẩm Shopee</label>
                <div class="dashboard-input-shell">
                    <span aria-hidden="true"><img src="~/catback/icons/link-dark.svg" alt="" /></span>
                    <input asp-for="LinkUrl" id="affiliate-url" type="url" inputmode="url" autocomplete="url" placeholder="Dán link Shopee tại đây..." required maxlength="2048" />
                    <button class="dashboard-input-clear" id="affiliate-url-clear" type="button" aria-label="Xóa link đang nhập" hidden>×</button>
                </div>
                <div id="url-status" class="url-status" data-state="@(Model.Error is not null ? "error" : Model.SuccessMessage is not null ? "success" : "idle")" role="status">@(Model.Error ?? Model.SuccessMessage ?? "Hỗ trợ link Shopee trực tiếp và link rút gọn hợp lệ.")</div>
                <button class="dashboard-create-button" type="submit" id="create-button">Tạo link hoàn tiền <span>→</span></button>
            </form>

            <section class="dashboard-links" aria-labelledby="your-links-heading">
                <header class="dashboard-section-heading">
                    <h2 id="your-links-heading">Link của bạn</h2>
                </header>

                @if (User.Identity?.IsAuthenticated != true)
                {
                    <div class="dashboard-empty"><h3>Đăng nhập để lưu link</h3><p>Link mua hàng sẽ xuất hiện tại đây sau khi bạn đăng nhập.</p><a class="dashboard-text-link" href="/Account/Login">Đăng nhập</a></div>
                }
                else if (Model.RecentLinks.Items.Count == 0)
                {
                    <div class="dashboard-empty dashboard-link-empty">
                        <img src="~/catback/icons/empty-box.svg" alt="" />
                        <h3>Bạn chưa có link nào</h3>
                        <p>Dán link Shopee để nhận hoàn tiền ngay!</p>
                        <div class="dashboard-link-empty-actions">
                            <button type="button" data-focus-link-input>Dán link ngay</button>
                            <a href="/huong-dan#tao-link-hoan-tien">Hướng dẫn tạo link <span>›</span></a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="affiliate-link-list">
                    @foreach (var item in Model.RecentLinks.Items)
                    {
                        var isNew = item.Id == Model.CreatedLinkId;
                        <article class="affiliate-link-card @(isNew ? "is-new" : string.Empty) @(item.IsHidden ? "is-hidden" : string.Empty)" id="@(isNew ? "latest-link" : string.Empty)" data-link-id="@item.Id">
                            <div class="affiliate-product-image">
                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl" alt="Ảnh @(item.ProductName ?? "sản phẩm Shopee")" loading="lazy" />
                                }
                                else
                                {
                                    <span><img src="~/catback/icons/shopping-bag.svg" alt="" /></span>
                                }
                            </div>
                            <div class="affiliate-link-details">
                                <h3>@(item.ProductName ?? "Sản phẩm Shopee")</h3>
                                <p class="affiliate-store">Sản phẩm từ Shopee</p>
                                @if (item.IsHidden)
                                {
                                    <span class="affiliate-hidden-badge">Đã ẩn</span>
                                }
                                @if (item.EstimatedCommission.HasValue)
                                {
                                    <p class="affiliate-estimate">Hoàn lại dự kiến @item.EstimatedCommission.Value.ToString("N0")₫</p>
                                }
                                else
                                {
                                    <p class="affiliate-estimate unavailable">Chưa có ước tính hoa hồng</p>
                                }
                            </div>
                            <div class="affiliate-link-actions">
                                <a class="affiliate-buy-button" href="@item.RedirectUrl" data-open-in-new-tab-on-desktop rel="nofollow sponsored noopener">Mua ngay</a>
                                <div class="affiliate-link-secondary-actions">
                                    @if (!string.IsNullOrWhiteSpace(item.AffiliateUrl))
                                    {
                                        <button class="affiliate-icon-action affiliate-copy-button" type="button" data-copy-url="@item.AffiliateUrl" aria-label="Sao chép link" title="Sao chép link">
                                            <img src="~/catback/icons/copy-link.svg" alt="" />
                                            <span class="sr-only" data-copy-label>Sao chép link</span>
                                        </button>
                                    }
                                    <form method="post" asp-page-handler="SetHidden" asp-antiforgery="true"
                                          data-link-visibility-form data-link-id="@item.Id">
                                        <input type="hidden" name="linkId" value="@item.Id" />
                                        <input type="hidden" name="visibilityAction" value="@(item.IsHidden ? "show" : "hide")" />
                                        <input type="hidden" name="showHidden" value="@Model.ShowHidden" />
                                        <button class="affiliate-icon-action affiliate-hide-desktop-button" type="submit"
                                                aria-label="@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")"
                                                title="@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")">
                                            <img data-visibility-icon src="@(item.IsHidden ? "/catback/icons/eye-off.svg" : "/catback/icons/trash.svg")" alt="" />
                                            <span class="sr-only" data-visibility-label>@(item.IsHidden ? "Bỏ ẩn link" : "Ẩn link khỏi danh sách")</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    }
                    </div>
                }
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <template id="affiliate-link-empty-template">
                        <div class="dashboard-empty dashboard-link-empty">
                            <img src="~/catback/icons/empty-box.svg" alt="" />
                            <h3>Bạn chưa có link nào</h3>
                            <p>Dán link Shopee để nhận hoàn tiền ngay!</p>
                            <div class="dashboard-link-empty-actions">
                                <button type="button" data-focus-link-input>Dán link ngay</button>
                                <a href="/huong-dan#tao-link-hoan-tien">Hướng dẫn tạo link <span>›</span></a>
                            </div>
                        </div>
                    </template>
                    <template id="affiliate-link-card-template">
                        <article class="affiliate-link-card is-new" data-link-id="">
                            <div class="affiliate-product-image">
                                <img data-product-image src="" alt="" loading="lazy" hidden />
                                <span data-product-placeholder><img src="~/catback/icons/shopping-bag.svg" alt="" /></span>
                            </div>
                            <div class="affiliate-link-details">
                                <h3 data-product-name>Sản phẩm Shopee</h3>
                                <p class="affiliate-store">Sản phẩm từ Shopee</p>
                                <p class="affiliate-estimate unavailable" data-estimated-commission>Chưa có ước tính hoa hồng</p>
                            </div>
                            <div class="affiliate-link-actions">
                                <a class="affiliate-buy-button" href="#" data-open-in-new-tab-on-desktop rel="nofollow sponsored noopener">Mua ngay</a>
                                <div class="affiliate-link-secondary-actions">
                                    <button class="affiliate-icon-action affiliate-copy-button" type="button" data-copy-url="" aria-label="Sao chép link" title="Sao chép link">
                                        <img src="~/catback/icons/copy-link.svg" alt="" />
                                        <span class="sr-only" data-copy-label>Sao chép link</span>
                                    </button>
                                    <form method="post" asp-page-handler="SetHidden" asp-antiforgery="true"
                                          data-link-visibility-form data-link-id="">
                                        <input type="hidden" name="linkId" value="" />
                                        <input type="hidden" name="visibilityAction" value="hide" />
                                        <input type="hidden" name="showHidden" value="false" />
                                        <button class="affiliate-icon-action affiliate-hide-desktop-button" type="submit" aria-label="Ẩn link khỏi danh sách" title="Ẩn link khỏi danh sách">
                                            <img data-visibility-icon src="~/catback/icons/trash.svg" alt="" />
                                            <span class="sr-only" data-visibility-label>Ẩn link khỏi danh sách</span>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </article>
                    </template>
                }
            </section>
        </div>

        <aside class="dashboard-sidebar">
            <section class="affiliate-guide" id="how">
                <h2>Để chắc chắn được tính hoa hồng</h2>
                <ol>
                    <li><span>1</span><p>Bấm <strong>Mua ngay</strong> để sang sàn rồi đặt hàng.</p></li>
                    <li><span>2</span><p><strong>Mỗi đơn một lần bấm.</strong> Mua thêm đơn nữa thì quay lại đây bấm Mua ngay lần nữa, không bấm lại thì đơn sau không được tính.</p></li>
                    <li><span>3</span><p>Đặt hàng <strong>trong vòng 7 ngày</strong> kể từ lúc bấm Mua ngay.</p></li>
                    <li><span>4</span><p><strong>Tuyệt đối đừng xem video hay livestream của sản phẩm đó</strong> trên sàn. Xem livestream sẽ kích hoạt hoa hồng cho bên livestream: CatBack không nhận được gì, nên cũng không có gì để chia lại cho bạn.</p></li>
                    <li><span>5</span><p>Sau khi bấm Mua ngay và truy cập sản phẩm trên sàn, <strong>đừng vội mua hàng ngay lập tức</strong>. Hãy kéo xuống đọc thông tin về sản phẩm vài giây rồi hãy chốt đơn nhé.</p></li>
                </ol>
            </section>
        </aside>
    </div>
</section>

@section Scripts {
<script src="~/customer.js" asp-append-version="true"></script>
}
