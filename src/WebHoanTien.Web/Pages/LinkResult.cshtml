@page
@model LinkResultModel
@{
    var isShop = Model.Tracking.TargetType == AffiliateLinkTargetType.Shop;
    var isProduct = Model.Tracking.TargetType == AffiliateLinkTargetType.Product;
    var shopFallback = !string.IsNullOrWhiteSpace(Model.Tracking.ShopId) ? $"Shop #{Model.Tracking.ShopId}" : "Cửa hàng Shopee";
    var resultTitle = isShop
        ? !string.IsNullOrWhiteSpace(Model.Tracking.ProductName) ? Model.Tracking.ProductName : shopFallback
        : isProduct ? Model.Tracking.ProductName ?? "Sản phẩm Shopee của bạn" : "Link Shopee";
    var shopImage = !string.IsNullOrWhiteSpace(Model.Tracking.ImageUrl)
        ? Model.Tracking.ImageUrl
        : "/catback/icons/shop-placeholder.svg";
    ViewData["Title"] = isShop ? "Link cửa hàng đã sẵn sàng" : "Link mua hàng đã sẵn sàng";
    var stableRedirectUrl = $"{Request.Scheme}://{Request.Host}{Request.PathBase}{Model.Tracking.RedirectUrl}";
}
<section class="page-shell narrow">
    <div class="panel result-panel @(isShop ? "is-shop-result" : !isProduct ? "is-legacy-result" : string.Empty)">
        <span class="success-mark">✓</span><span class="eyebrow">Link đã sẵn sàng</span>
        @if (isShop)
        {
            <div class="result-shop-identity">
                <img src="@shopImage" alt="Ảnh @resultTitle" onerror="this.onerror=null;this.src='/catback/icons/shop-placeholder.svg'" />
                <div><h1>@resultTitle</h1><span class="affiliate-target-badge">Link cửa hàng</span></div>
            </div>
            <p class="muted">Mở Shop để chọn nhiều sản phẩm và thêm vào giỏ hàng trong cùng một phiên mua.</p>
        }
        else if (!isProduct)
        {
            <h1>@resultTitle</h1>
            <p class="muted">Link cũ chưa phân loại. Link chuyển hướng vẫn tiếp tục hoạt động.</p>
        }
        else if (Model.Tracking.EstimatedCommission.HasValue)
        {
            <h1>@resultTitle</h1>
            <p class="estimate">Hoa hồng ước tính: <strong>@Model.Tracking.EstimatedCommission.Value.ToString("N0") ₫</strong></p>
        }
        else
        {
            <h1>@resultTitle</h1>
            <p class="muted">Ước tính chưa có; việc này không ảnh hưởng đến link mua hàng.</p>
        }
        <div class="copy-row"><input id="result-url" readonly value="@stableRedirectUrl" /><button class="button button-ghost" type="button" onclick="navigator.clipboard.writeText(document.getElementById('result-url').value)">Sao chép</button></div>
        <a class="button button-dark button-wide" href="@Model.Tracking.RedirectUrl" data-open-in-new-tab-on-desktop data-turbo="false" rel="nofollow sponsored noopener">@(isShop ? "Vào Shop mua hàng →" : isProduct ? "Mua trên Shopee →" : "Mở Shopee →")</a>
        <p class="fine-print">Hãy hoàn tất đơn trong cùng phiên sau khi mở link. Shopee quyết định việc ghi nhận và xác thực hoa hồng.</p>
    </div>
    <p class="center"><a href="/Links">Xem các link đã tạo</a> · <a href="/Orders">Đơn của tôi</a></p>
</section>
