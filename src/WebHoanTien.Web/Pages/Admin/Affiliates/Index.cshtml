@page
@model WebHoanTien.Web.Pages.Admin.Affiliates.IndexModel
@{ ViewData["Title"] = "Quản trị affiliate"; }
<section class="page-shell">
    <div class="page-heading">
        <div><span class="eyebrow">Operations</span><h1>Quản trị affiliate</h1></div>
        <div class="page-heading-actions"><a class="button button-ghost" href="/Admin/Settlements">Duyệt đối soát</a><a class="button button-ghost" href="/Admin/Settings">Cấu hình email</a></div>
    </div>
    @if (TempData["ImportMessage"] is string message) { <div class="flash">@message</div> }
    @if (TempData["SettlementMessage"] is string settlementMessage) { <div class="flash">@settlementMessage</div> }
    @if (TempData["CommissionMessage"] is string commissionMessage) { <div class="flash">@commissionMessage</div> }
    <div class="step-grid">
        <article><b>@(Model.Connection.IsConfigured ? "✓" : "!")</b><h3>Affiliate ID</h3><p>Link tạo bởi ứng dụng dùng <code>@Model.Connection.Mode</code>.</p></article>
        <article><b>@Model.CurrentCommissionRule.UserShareRate.ToString("0.##")%</b><h3>Khách nhận</h3><p>Áp dụng cho estimate mới và đơn Shopee theo thời điểm đặt hàng.</p></article>
        <article><b>CSV</b><h3>Nguồn chi trả</h3><p>Đơn hoàn thành chỉ được rút sau khi có bảng kê Shopee đã thanh toán.</p></article>
    </div>
    <form method="post" asp-page-handler="SetCommissionRate" class="panel commission-rate-form">
        <div>
            <span class="eyebrow">Tỷ lệ chia hoa hồng</span>
            <h2>Khách hàng nhận</h2>
            <p>Estimate tạo từ bây giờ dùng tỷ lệ này. Đơn đã import giữ nguyên số tiền đã chốt.</p>
        </div>
        <label asp-for="UserShareRate">Tỷ lệ khách nhận (%)</label>
        <div class="commission-rate-input"><input asp-for="UserShareRate" type="number" min="0" max="100" step="0.01" inputmode="decimal" /><span>%</span></div>
        <span asp-validation-for="UserShareRate" class="field-error"></span>
        <button class="button button-primary" type="submit">Áp dụng tỷ lệ</button>
    </form>
    <section class="panel affiliate-override-panel" aria-labelledby="affiliate-override-heading">
        <div class="affiliate-override-heading">
            <div>
                <span class="eyebrow">Định tuyến theo tài khoản</span>
                <h2 id="affiliate-override-heading">Affiliate ID riêng theo tài khoản</h2>
                <p>User không có cấu hình riêng sẽ tự dùng Affiliate ID Shopee mặc định trong appsettings.</p>
            </div>
            <form method="get" class="affiliate-override-search">
                <label class="sr-only" for="affiliate-override-filter">Tìm theo email hoặc Affiliate ID</label>
                <input id="affiliate-override-filter" name="AffiliateOverrideFilter" value="@Model.AffiliateOverrideFilter"
                       placeholder="Tìm email hoặc Affiliate ID" maxlength="256" />
                <button class="button button-ghost" type="submit">Tìm</button>
            </form>
        </div>

        <form method="post" asp-page-handler="SetAffiliateOverride" class="affiliate-override-form" data-turbo="false"
              id="affiliate-override-form" data-affiliate-override-form>
            <label>Email tài khoản
                <select name="userEmail" required>
                    <option value="">Chọn tài khoản...</option>
                    @foreach (var user in Model.AffiliateUsers.Items)
                    {
                        <option value="@user.Email">@user.Email</option>
                    }
                </select>
            </label>
            <label>Shopee Affiliate ID
                <input name="affiliateId" required maxlength="128" pattern="[A-Za-z0-9_-]+"
                       placeholder="an_123456789" />
            </label>
            <label class="affiliate-override-note">Ghi chú nội bộ
                <input name="adminNote" maxlength="500" placeholder="Lý do áp dụng cấu hình riêng (không bắt buộc)" />
            </label>
            <button class="button button-primary" type="submit">Lưu cấu hình riêng</button>
            <button class="button button-ghost" type="reset">Nhập mới</button>
        </form>
        <form method="post" asp-page-handler="RemoveAffiliateOverride" id="affiliate-override-remove-form" data-turbo="false" hidden></form>
        <p class="affiliate-override-status" data-affiliate-override-status role="status" aria-live="polite"></p>

        <div class="affiliate-override-list" data-affiliate-override-list>
            @foreach (var item in Model.AffiliateIdOverrides.Items)
            {
                <article class="affiliate-override-row" data-user-id="@item.UserId">
                    <div class="affiliate-override-user">
                        <strong data-user-email>@item.UserEmail</strong>
                        <span>Shopee · cập nhật @((item.LastModificationTime ?? item.CreationTime).ToLocalTime().ToString("dd/MM/yyyy HH:mm"))</span>
                    </div>
                    <code data-affiliate-id>@item.AffiliateId</code>
                    <p data-admin-note>@(string.IsNullOrWhiteSpace(item.AdminNote) ? "Không có ghi chú" : item.AdminNote)</p>
                    <div class="affiliate-override-actions">
                        <button class="button button-ghost" type="button" data-affiliate-override-edit>Sửa</button>
                        <button class="button button-danger" type="button" data-affiliate-override-remove>Về ID mặc định</button>
                    </div>
                </article>
            }
            <p class="affiliate-override-empty" data-affiliate-override-empty
               hidden="@(Model.AffiliateIdOverrides.Items.Count > 0 ? "hidden" : null)">
                Chưa có tài khoản nào dùng Affiliate ID riêng.
            </p>
        </div>
        <p class="fine-print affiliate-override-warning">Bạn cần import báo cáo từ tất cả tài khoản Shopee Affiliate đang được sử dụng. Hệ thống vẫn ghép user bằng tracking token trong Sub ID.</p>
    </section>
    <form method="post" enctype="multipart/form-data" asp-page-handler="Import" class="card-list" data-turbo="false">
        <label for="shopee-report">Báo cáo chuyển đổi Shopee (CSV/TXT)</label>
        <input id="shopee-report" asp-for="Report" type="file" accept=".csv,.txt,text/csv,text/plain" required />
        <p class="fine-print">Cần có các cột: Mã đơn hàng, Sub ID, Thời gian đặt hàng và Hoa hồng thực nhận. Có thể thêm trạng thái, sản phẩm, số lượng và giá trị đơn.</p>
        <p class="fine-print">Báo cáo này chỉ cập nhật đơn phát sinh và trạng thái hoàn thành; chưa cộng tiền vào số dư rút được.</p>
        <button class="button button-primary" type="submit">Import báo cáo chuyển đổi</button>
    </form>
    <form method="post" enctype="multipart/form-data" asp-page-handler="ImportSettlement" class="card-list" data-turbo="false">
        <label for="shopee-settlement-report">Bảng kê Shopee đã thanh toán (CSV/TXT)</label>
        <input id="shopee-settlement-report" asp-for="SettlementReport" type="file" accept=".csv,.txt,text/csv,text/plain" required />
        <p class="fine-print">Cần có cột ID đơn hàng và Số tiền Shopee thực trả sau các khoản cấn trừ. File import chỉ tạo dữ liệu chờ duyệt, chưa cộng tiền vào ví.</p>
        <p class="fine-print"><a href="~/templates/shopee-settlement-template.csv" download data-turbo="false">>Tải file CSV mẫu</a></p>
        <button class="button button-primary" type="submit">Import đối soát chờ duyệt</button>
    </form>
    <p class="fine-print"><a href="/hangfire" data-turbo="false">Mở Hangfire Dashboard</a> · API import: <code>POST /api/app/admin/shopee-reports/import</code>.</p>
</section>

@section Scripts {
    <script src="~/admin-affiliate-overrides.js" asp-append-version="true"></script>
}
