@page "/tiktok-affiliate"
@model WebHoanTien.Web.Pages.TikTokAffiliateModel
@{
    ViewData["Title"] = "Tiếp thị liên kết TikTok";
    ViewData["BodyClass"] = "catback-tiktok-page";
}
@section Styles {
    <link rel="stylesheet" href="~/tiktok-affiliate.css" asp-append-version="true" />
}
<section class="customer-dashboard tt-workspace" data-tiktok-affiliate>
    <div class="cb-mobile-page-header tt-mobile-header">
        <partial name="/Pages/Shared/_CustomerHeader.cshtml" model="@(new WebHoanTien.Web.Pages.Shared.CustomerHeaderModel { Title = "Tiếp thị liên kết TikTok", BackUrl = "/", BackLabel = "Quay về CatBack" })" />
    </div>
    <header class="tt-hero">
        <div><p class="tt-eyebrow">CATBACK · TIKTOK SHOP</p><h1>Tiếp thị liên kết TikTok</h1><p>Dán link sản phẩm, tạo liên kết tiếp thị và theo dõi đơn hàng qua CatBack.</p></div>
        <span class="tt-market"><i class="fa-brands fa-tiktok" aria-hidden="true"></i> TikTok Shop</span>
    </header>
    @if (!Model.Integration.IsAvailable)
    {
        <div class="tt-service-banner" role="status"><strong>Kết nối TikTok chưa sẵn sàng</strong><p>Admin cần cấu hình và authorize Creator để bắt đầu tạo liên kết.</p></div>
    }
    <div class="tt-tabs" role="tablist" aria-label="Các mục tiếp thị liên kết TikTok">
        <button id="tt-tab-overview" type="button" role="tab" aria-selected="true" aria-controls="tt-overview" data-tt-tab="overview">Tổng quan</button>
        <button id="tt-tab-links" type="button" role="tab" aria-selected="false" aria-controls="tt-links" tabindex="-1" data-tt-tab="links">Link đã tạo <span data-tt-link-count>0</span></button>
        <button id="tt-tab-orders" type="button" role="tab" aria-selected="false" aria-controls="tt-orders" tabindex="-1" data-tt-tab="orders">Đơn hàng Affiliate</button>
    </div>
    <p class="tt-feedback" data-tt-feedback role="status" aria-live="polite" hidden></p>
    @if (!string.IsNullOrEmpty(Model.ConnectionNotice))
    {
        <p class="tt-feedback" data-kind="success" role="status">@Model.ConnectionNotice</p>
    }
    @if (!string.IsNullOrEmpty(Model.ConnectionError))
    {
        <p class="tt-feedback" data-kind="error" role="alert">@Model.ConnectionError</p>
    }
    <section id="tt-overview" role="tabpanel" aria-labelledby="tt-tab-overview" class="tt-overview-grid">
        <div class="tt-flow">
            <section class="cb-card tt-card" aria-labelledby="tt-creator-heading">
                <header class="tt-card-heading"><span class="tt-step">01</span><div><h2 id="tt-creator-heading">Kết nối Creator</h2><p>Creator đã cấp quyền TikTok cho CatBack</p></div><span class="tt-status @(Model.Creator is not null ? "is-connected" : "")">@(Model.Creator is not null ? "Đã kết nối TikTok" : "Chưa kết nối")</span></header>
                <div class="tt-connection">
                    <div class="tt-avatar" aria-hidden="true"><i class="fa-brands fa-tiktok"></i></div>
                    <div class="tt-creator-copy"><h3>@(Model.Creator is not null ? "@" + Model.Creator.Username : "Chưa có Creator được xác minh")</h3><p>@(Model.Creator is not null ? $"Thị trường {Model.Creator.Market}. Liên kết của bạn sử dụng Creator chung của CatBack." : Model.CanConnectCreator ? "Bấm Kết nối với tài khoản TikTok Creator để cấp quyền và bắt đầu tạo link." : "Admin kết nối Creator để CatBack tạo link và lấy đơn hàng.")</p></div>
                </div>
                @if (Model.CanConnectCreator)
                {
                    <div class="tt-connection-actions">
                        <form method="post" action="/api/tiktok-shop/oauth/connect" data-turbo="false" data-tt-connect-form data-page-loading="false" data-loading-text="Đang mở TikTok…">
                            @Html.AntiForgeryToken()
                            <button class="tt-button" type="submit" disabled="@(!Model.Integration.IsAvailable)">Kết nối với tài khoản TikTok Creator</button>
                        </form>
                        <form method="post" asp-page-handler="Disconnect" data-turbo="false" data-tt-disconnect-form data-page-loading="false" data-loading-text="Đang ngắt kết nối…">
                            @Html.AntiForgeryToken()
                            <button class="tt-button tt-button-secondary" type="submit" disabled="@(!Model.CanDisconnectCreator)">Ngắt kết nối</button>
                        </form>
                    </div>
                    @if (Model.CanManageConnection)
                    {
                        <a href="/Admin/TikTokCreator" class="tt-text-button">Quản lý kết nối Creator</a>
                    }
                    <p class="tt-caption">Kết nối mở trang cấp quyền thật của TikTok. Ngắt kết nối tại CatBack sẽ dừng Creator chung; thao tác này không thu hồi quyền trên TikTok.</p>
                }
                <p class="tt-caption">Đăng nhập đúng Creator chính tại TikTok khi cấp quyền. Kết nối được lưu trong database chung để local và production cùng sử dụng.</p>
            </section>
            <section class="cb-card tt-card" aria-labelledby="tt-product-heading">
                <header class="tt-card-heading"><span class="tt-step">02</span><div><h2 id="tt-product-heading">Tạo link TikTok</h2><p>Nhận liên kết tiếp thị cùng thông tin sản phẩm</p></div></header>
                <form data-tt-product-form data-turbo="false" method="post" asp-page-handler="Generate">
                    @Html.AntiForgeryToken()
                    <label for="tt-product-url">Liên kết hoặc ID sản phẩm TikTok Shop</label>
                    <div class="tt-input-row"><input id="tt-product-url" name="productUrlOrId" type="text" autocomplete="off" maxlength="@WebHoanTien.WebHoanTienConsts.AffiliateInputUrlMaxLength" placeholder="Dán link TikTok Shop hoặc ID sản phẩm" required disabled="@(Model.Creator is null)" /><button class="tt-button" type="submit" data-tt-create disabled="@(Model.Creator is null)">Tạo link TikTok</button></div>
                </form>
                <p class="tt-caption">Hỗ trợ link rút gọn TikTok và link trực tiếp. Sản phẩm cần đủ điều kiện tiếp thị liên kết.</p>
                <div class="tt-product" data-tt-product hidden>
                    <img data-tt-product-image alt="Ảnh sản phẩm" width="160" height="160" referrerpolicy="no-referrer" hidden />
                    <div><span class="tt-label">SẢN PHẨM TIKTOK SHOP</span><h3 data-tt-product-title></h3><p data-tt-product-shop></p><strong class="tt-price" data-tt-product-price></strong><div class="tt-commission"><span>Hoa hồng Creator dự kiến</span><strong data-tt-product-commission></strong></div><div class="tt-commission"><span>Hoàn tiền của bạn dự kiến</span><strong data-tt-product-cashback></strong></div><p class="tt-caption" data-tt-rate-note></p></div>
                </div>
            </section>
            <section class="cb-card tt-card" aria-labelledby="tt-generate-heading">
                <header class="tt-card-heading"><span class="tt-step">03</span><div><h2 id="tt-generate-heading">Liên kết của bạn</h2><p>Sao chép và chia sẻ sau khi tạo thành công</p></div></header>
                <p class="tt-caption" data-tt-result-placeholder>Tạo link TikTok ở bước trên để nhận liên kết chia sẻ.</p>
                <div class="tt-link-result" data-tt-result hidden>
                    <strong class="tt-success" data-tt-result-title>Đã tạo liên kết tiếp thị.</strong>
                    <p class="tt-caption" data-tt-result-note>Liên kết đã được lưu trong tài khoản CatBack của bạn.</p>
                    <label for="tt-sharing-link">Liên kết chia sẻ</label>
                    <div class="tt-input-row"><input id="tt-sharing-link" type="text" readonly /><button class="tt-button tt-button-secondary" type="button" data-tt-copy-result>Sao chép liên kết</button></div>
                    <div class="tt-result-footer"><small data-tt-link-time></small><button type="button" class="tt-text-button" data-tt-show-links>Xem link đã tạo →</button></div>
                </div>
            </section>
        </div>
        <aside class="tt-review-guide cb-card">
            <span class="tt-label">TIKTOK SHOP · CATBACK</span><h2>Từ sản phẩm<br />đến liên kết chia sẻ.</h2>
            <ol><li><strong>Dán link sản phẩm</strong><span>Dùng link rút gọn, link trực tiếp hoặc ID sản phẩm.</span></li><li><strong>Tạo liên kết</strong><span>Nhận link có mã theo dõi riêng và thông tin sản phẩm khi có.</span></li><li><strong>Chia sẻ và theo dõi</strong><span>Xem các liên kết đã lưu và đơn hàng được ghi nhận.</span></li></ol>
            <div class="tt-guide-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><p>Ảnh và hoa hồng sản phẩm được đọc từ TikTok. Đơn hàng được admin lấy khi bấm nút. Đối soát và cộng ví sẽ triển khai sau.</p></div>
        </aside>
    </section>
    <section id="tt-links" role="tabpanel" aria-labelledby="tt-tab-links" class="cb-card tt-card tt-list-panel" hidden>
        <header class="tt-list-heading"><div><span class="tt-label">THƯ VIỆN LIÊN KẾT</span><h2>Link đã tạo</h2><p>@(Model.Creator is not null ? $"Toàn bộ link CatBack đã tạo bằng Creator @{Model.Creator.Username}." : "Toàn bộ link CatBack đã lưu của Creator đang kết nối.")</p></div><div class="tt-table-actions"><button type="button" class="tt-button tt-button-secondary" data-tt-refresh-links>Làm mới</button><button type="button" class="tt-button tt-button-secondary" data-tt-show-overview>Tạo liên kết →</button></div></header>
        <div class="tt-empty" data-tt-links-empty><i class="fa-solid fa-link" aria-hidden="true"></i><h3>Chưa có liên kết</h3><p>Dán link sản phẩm để tạo liên kết TikTok Shop đầu tiên.</p></div>
        <p class="tt-caption">Hoa hồng tổng dự kiến là khoản Creator nhận cho mỗi sản phẩm, trước khi chia hoàn tiền; có thể thay đổi theo SKU và ưu đãi.</p>
        <p class="tt-caption">Mỗi link ghi nhận hoàn tiền cho tài khoản CatBack đã tạo link đó. Link đã ẩn khỏi danh sách cá nhân vẫn được lưu trong thư viện Creator.</p>
        <div class="tt-table-scroll" data-tt-links-table hidden><table><thead><tr><th scope="col">Sản phẩm</th><th scope="col">Hoa hồng tổng dự kiến</th><th scope="col">Ngày tạo</th><th scope="col">Trạng thái</th><th scope="col">Thao tác</th></tr></thead><tbody data-tt-links-body></tbody></table></div>
    </section>
    <section id="tt-orders" role="tabpanel" aria-labelledby="tt-tab-orders" class="cb-card tt-card tt-list-panel" hidden>
        <header class="tt-list-heading"><div><span class="tt-label">ĐƠN HÀNG TIKTOK SHOP</span><h2>Đơn hàng</h2><p>@(Model.IsAdminOrderView ? "Phạm vi quản trị: đơn đã lấy từ TikTok của tất cả khách hàng, bao gồm đơn chưa khớp lượt bấm." : "Đơn đã được admin đồng bộ từ TikTok và khớp với liên kết của bạn.")</p></div><div class="tt-table-actions"><span class="tt-status" data-tt-orders-count>0 đơn</span><button type="button" class="tt-button tt-button-secondary" data-tt-refresh-orders>Làm mới danh sách</button></div></header>
        <form method="get" class="tt-order-filters" data-tt-order-filters>
            <input type="hidden" name="Tab" value="orders" /><input type="hidden" name="PageNumber" value="@Model.PageNumber" />
            <label>Từ ngày đặt đơn<input asp-for="FromDate" /></label><label>Đến hết ngày<input asp-for="ToDate" /></label>
            <label>Trạng thái<select asp-for="StatusGroup"><option value="">Tất cả</option><option value="pending">Chờ đối soát</option><option value="confirmed">Đã ghi nhận</option><option value="cancelled">Hủy / hoàn / từ chối</option></select></label>
            <button class="tt-button tt-button-secondary" type="submit">Lọc đơn hàng</button>
            @if (Model.CanSync) { <button class="tt-button" type="button" data-tt-sync-orders disabled="@(Model.Creator is null)">Lấy đơn từ TikTok</button> }
        </form>
        <p class="tt-caption">Ngày đặt đơn theo giờ Việt Nam, tối đa 90 ngày mỗi lượt. Làm mới danh sách đọc dữ liệu đã lưu; admin bấm Lấy đơn từ TikTok để gọi API. Chưa có job tự động hoặc xử lý cộng ví.</p>
        <p class="tt-feedback" role="status" data-tt-orders-error hidden></p>
        <div class="tt-empty" data-tt-orders-empty><i class="fa-solid fa-bag-shopping" aria-hidden="true"></i><h3>Chưa có đơn hàng phù hợp</h3><p>Chọn khoảng ngày đặt đơn hoặc đợi admin lấy dữ liệu từ TikTok.</p></div>
        <div class="tt-table-scroll" data-tt-orders-table hidden><table><thead><tr><th scope="col">Mã đơn</th><th scope="col">Sản phẩm</th><th scope="col">Giá trị đơn</th>
            @if (Model.IsAdminOrderView) { <th scope="col">Hoa hồng TikTok thực nhận</th> }
            <th scope="col">Trạng thái</th><th scope="col">Ngày đặt</th><th scope="col">Chi tiết</th></tr></thead><tbody data-tt-orders-body></tbody></table></div>
        <nav class="tt-table-actions" data-tt-orders-pagination hidden aria-label="Phân trang đơn hàng"><button type="button" class="tt-button tt-button-secondary" data-tt-orders-prev>Trang trước</button><span data-tt-orders-page></span><button type="button" class="tt-button tt-button-secondary" data-tt-orders-next>Trang sau</button></nav>
    </section>
    <script type="application/json" data-tt-initial>@Html.Raw(Model.InitialStateJson)</script>
</section>
@section Scripts {
    <script src="~/tiktok-affiliate.js" asp-append-version="true"></script>
}
