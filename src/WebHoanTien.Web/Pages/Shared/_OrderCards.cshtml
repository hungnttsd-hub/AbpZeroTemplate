@model OrdersModel

@foreach (var order in Model.Orders.Items)
{
    var firstItem = order.Items.FirstOrDefault();
    var productName = string.IsNullOrWhiteSpace(firstItem?.ProductName) ? "Sản phẩm Shopee" : firstItem.ProductName;
    var statusClass = CustomerOrderUi.GetStatusClass(order.Status);
    <article class="cb-order-card @(Model.IsAdminOrderView ? "cb-order-card-admin" : null)" data-order-id="@order.Id">
        <div class="cb-order-card-top">
            <div class="cb-order-product-image">
                @if (!string.IsNullOrWhiteSpace(firstItem?.ImageUrl ?? order.ProductImageUrl))
                {
                    <img src="@(firstItem?.ImageUrl ?? order.ProductImageUrl)" alt="Ảnh @productName" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false" />
                    <span hidden><img src="~/orders-icons/store.svg" alt="" /></span>
                }
                else
                {
                    <span><img src="~/orders-icons/store.svg" alt="" /></span>
                }
            </div>
            <div class="cb-order-product-copy">
                <h2>@productName</h2>
                <p><img src="~/orders-icons/store.svg" alt="" />Sản phẩm từ Shopee</p>
                <time datetime="@order.PurchaseTime.ToString("O")"><img src="~/orders-icons/clock.svg" alt="" />@CustomerOrderUi.FormatDate(order.PurchaseTime)</time>
                <span class="cb-status cb-status-@statusClass">@CustomerOrderUi.GetStatusLabel(order.Status)</span>
            </div>
        </div>
        @if (Model.IsAdminOrderView)
        {
            <div class="cb-order-user">
                <span>Người nhận</span>
                <strong>@(order.Recipients.Count == 0
                    ? "Chưa xác định"
                    : string.Join(" · ", order.Recipients.Select(x =>
                        $"{x.UserEmail ?? x.UserId.ToString()} (+{CustomerOrderUi.FormatMoney(x.SettledUserCommission ?? x.ExpectedUserCommission)})")))</strong>
                @if (order.UnmatchedAttributionCount > 0)
                {
                    <small>@order.UnmatchedAttributionCount token chưa ghép hoặc đang xung đột</small>
                }
            </div>
        }
        <dl class="cb-order-values">
            <div>
                <dt>Số tiền đơn hàng</dt>
                <dd>@CustomerOrderUi.FormatMoney(order.PurchaseAmount)</dd>
            </div>
            <div>
                <dt>@(CustomerOrderUi.IsConfirmed(order.Status) ? "Bạn nhận được" : "Hoàn tiền dự kiến")</dt>
                <dd class="cb-cashback-value">+@CustomerOrderUi.FormatMoney(CustomerOrderUi.DisplayCommission(order))</dd>
            </div>
            <div>
                <dt>Mã đơn hàng</dt>
                <dd class="cb-order-code">
                    <span>@order.ExternalOrderId</span>
                    <button type="button" data-copy-order-code="@order.ExternalOrderId" aria-label="Sao chép mã đơn hàng @order.ExternalOrderId">
                        <img src="~/orders-icons/copy.svg" alt="" />
                    </button>
                </dd>
            </div>
        </dl>
        <a class="cb-order-detail-link" href="/Orders/@order.Id?returnUrl=@Uri.EscapeDataString(Model.ReturnUrl)">
            <span>Xem chi tiết</span><img src="~/orders-icons/chevron-right.svg" alt="" />
        </a>
    </article>
}
