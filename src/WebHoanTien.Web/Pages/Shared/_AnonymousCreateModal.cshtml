@model WebHoanTien.Web.Pages.Account.AccountFlowModel
@{
    var actionLabel = Model.Remembered ? "Đăng nhập" : "Tạo tài khoản";
}
<dialog class="cb-anonymous-create-dialog" data-anonymous-create aria-labelledby="anonymous-create-title" aria-describedby="anonymous-create-description" data-auto-open="@(Model.ShowAnonymous ? "true" : "false")">
    <button type="button" class="cb-anonymous-close" data-anonymous-dismiss aria-label="Đóng">×</button>
    <img class="cb-anonymous-mascot" src="~/catback-mascot-reference.png" alt="CatBack" />
    <h2 id="anonymous-create-title" tabindex="-1">@(Model.Remembered ? "Đăng nhập tài khoản ẩn danh?" : "Tạo tài khoản ẩn danh?")</h2>
    <p id="anonymous-create-description">@(Model.Remembered ? "Thiết bị này còn ghi nhớ tài khoản ẩn danh của bạn. Đăng nhập để tiếp tục sử dụng link, đơn hàng và cashback đã lưu." : "Bạn sẽ có một tài khoản tự động, không cần đăng ký ngay, để lưu link, xem đơn hàng và nhận cashback.")</p>
    <div class="cb-anonymous-benefits">
        <div><i class="fa-solid fa-link" aria-hidden="true"></i><div><strong>Lưu link và đơn hàng</strong><p>Link, đơn hàng và cashback được lưu trên tài khoản này.</p></div></div>
        <div><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i><div><strong>Dùng trên thiết bị này</strong><p>Ghi nhớ tài khoản trên thiết bị hiện tại.</p></div></div>
        <div><i class="fa-solid fa-clock-rotate-left" aria-hidden="true"></i><div><strong>Có mã khôi phục</strong><p>Dùng mã để lấy lại tài khoản khi đổi máy hoặc mất dữ liệu trình duyệt.</p></div></div>
    </div>
    <form method="post" action="/api/account/anonymous" data-account-api="/api/account/anonymous" data-turbo="false">
        @Html.AntiForgeryToken()
        <input type="hidden" name="returnUrl" value="@Model.SafeReturnUrl" />
        <input type="hidden" name="acceptedTerms" value="true" />
        <p class="cb-anonymous-legal">Bấm @actionLabel nghĩa là bạn đồng ý với <a href="/Legal/Terms" target="_blank">Điều khoản</a> và <a href="/Legal/Privacy" target="_blank">Chính sách riêng tư</a>.</p>
        @if (!Model.CreationEnabled && !Model.Remembered)
        {
            <p class="cb-account-warning">Tạo tài khoản ẩn danh đang tạm dừng. Bạn có thể <a href="@Model.WithReturn("/Account/Recovery")">khôi phục bằng mã</a>.</p>
        }
        <p data-account-status role="status" hidden></p>
        <button type="submit" class="button cb-account-primary" data-loading-label="@(Model.Remembered ? "Đang đăng nhập…" : "Đang tạo tài khoản…")" disabled="@(!Model.CreationEnabled && !Model.Remembered)">@actionLabel</button>
        <button type="button" class="button cb-account-secondary" data-anonymous-dismiss>Bỏ qua</button>
    </form>
    <p class="cb-anonymous-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i><span>Tài khoản ẩn danh chưa được rút tiền. Bạn có thể đăng ký tài khoản sau để sử dụng đầy đủ tính năng.</span></p>
</dialog>
